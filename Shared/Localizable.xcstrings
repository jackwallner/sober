    "Change rooms or step outside for five minutes. Urges are tied to the place they usually happen." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejdi do jiné místnosti nebo jdi na pět minut ven. Chutě se často pojí s místem, kde se objevují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle den Raum oder geh fünf Minuten raus. Das Verlangen ist oft an den Ort gebunden, an dem es aufkommt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε δωμάτιο ή βγες έξω για πέντε λεπτά. Η λαχτάρα συνδέεται με το μέρος που συνήθως εμφανίζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de habitación o sal cinco minutos. Las ganas están ligadas al lugar donde suelen aparecer."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mine teise tuppa või viieks minutiks õue. Tungid on seotud kohaga, kus need tavaliselt tekivad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda huonetta tai mene ulos viideksi minuutiksi. Himot ovat sidoksissa paikkaan, jossa ne yleensä iskevät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de pièce ou sortez cinq minutes. Les envies sont liées au lieu où elles surviennent d'habitude."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमरा बदलें या पाँच मिनट बाहर चले जाएँ। तलब अक्सर उन जगहों से जुड़ी होती है जहाँ वह आमतौर पर उठती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menj át egy másik szobába, vagy lépj ki öt percre. A késztetések gyakran ahhoz a helyhez kötődnek, ahol jelentkezni szoktak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia stanza o esci per cinque minuti. Le voglie sono legate ai luoghi in cui si presentano di solito."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადადი სხვა ოთახში ან ხუთი წუთით გარეთ გადი. ლტოლვა იმ ადგილთანაა დაკავშირებული, სადაც ჩვეულებრივ ჩნდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakeisk kambarį arba išeik penkioms minutėms į lauką. Potraukiai susiję su vieta, kur jie paprastai užeina."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt rom eller gå ut i fem minutter. Sug henger sammen med stedet der de pleier å komme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga naar een andere kamer of loop vijf minuten naar buiten. De drang hangt vaak samen met de plek waar die meestal opkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź do innego pokoju albo wyjdź na pięć minut. Głód alkoholowy często wiąże się z miejscem, w którym zwykle się pojawia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mergi în altă cameră sau ieși afară cinci minute. Impulsurile sunt legate de locul în care apar de obicei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смените комнату или выйдите на пять минут. Тяга привязана к месту, где она обычно возникает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt rum eller gå ut i fem minuter. Impulser är knutna till platsen där de brukar uppstå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเปลี่ยนห้องหรือออกไปข้างนอกสักห้านาที แรงกระตุ้นให้อยากดื่มอาจเชื่อมโยงกับสถานที่ที่มักเกิดขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oda değiştir veya beş dakikalığına dışarı çık. İstekler genellikle ortaya çıktıkları yerle bağlantılıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть кімнату або вийдіть на п’ять хвилин. Потяг прив’язаний до місця, де він зазвичай виникає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi phòng hoặc ra ngoài năm phút. Cơn thèm gắn với nơi nó thường xuất hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换个房间，或出去待五分钟。冲动往往与它出现的地方有关。"
          }
        }
      }
    },
    "Change the first ten minutes: a different route home, seat, or glass." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prvních deset minut udělej jinak: jdi domů jinudy, sedni si jinam nebo zvol jinou sklenici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestalte die ersten zehn Minuten anders: mit einem anderen Heimweg, Sitzplatz oder Glas."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε τα πρώτα δέκα λεπτά: άλλη διαδρομή, άλλη θέση, άλλο ποτήρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia los primeros diez minutos: otra ruta a casa, otro asiento u otro vaso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuda esimest kümmet minutit: vali teine kodutee, istekoht või klaas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuta ensimmäisen kymmenen minuutin rutiinia: valitse eri reitti kotiin, istumapaikka tai lasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez les dix premières minutes : autre trajet, autre place, autre verre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआत के दस मिनट का तरीका बदलें: घर लौटने का दूसरा रास्ता, बैठने की दूसरी जगह या दूसरा गिलास।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Változtass az első tíz percen: válassz másik útvonalat hazafelé, másik helyet vagy poharat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia la routine dei primi dieci minuti: fai un altro percorso per tornare a casa, siediti altrove o usa un altro bicchiere."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პირველი ათი წუთი სხვაგვარად გაატარე: სახლში სხვა გზით წადი, სხვა ადგილზე დაჯექი ან სხვა ჭიქა აიღე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakeisk pirmąsias dešimt minučių: rinkis kitą kelią namo, kitą vietą ar kitą stiklinę."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endre de første ti minuttene: ta en annen vei hjem, sett deg et annet sted eller bruk et annet glass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verander de eerste tien minuten: een andere route, stoel of glas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień coś w pierwszych dziesięciu minutach: wróć inną drogą, usiądź gdzie indziej lub wybierz inną szklankę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbă primele zece minute: alege alt drum spre casă, alt loc sau alt pahar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первые десять минут проведите иначе: выберите другой маршрут домой, место или стакан."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändra de första tio minuterna: välj en annan väg hem, sittplats eller ett annat glas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเปลี่ยนสิ่งที่ทำในสิบนาทีแรก เช่น เปลี่ยนทางกลับบ้าน ที่นั่ง หรือแก้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk on dakikayı değiştir: eve farklı bir yoldan git, başka bir yere otur veya farklı bir bardak kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть перші десять хвилин: інший шлях додому, місце чи склянку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi mười phút đầu: đường về khác, chỗ ngồi hay ly khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改变最初的十分钟：换一条回家的路、一个座位或一个杯子。"
          }
        }
      }
    },
