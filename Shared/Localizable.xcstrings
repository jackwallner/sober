        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell hver dag, dyrk en privat bonsai og se hva kroppen og lommeboka får tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
