    "Ancient and weathered. This tree has seen a lot." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prastará a ošlehaná. Tenhle strom už toho zažil hodně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uralt und verwittert. Dieser Baum hat viel erlebt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αρχαίο και φθαρμένο. Αυτό το δέντρο έχει δει πολλά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancestral y curtido. Este árbol ha visto mucho."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikivanha ja sään kuluttama. Tämä puu on nähnyt paljon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancien et patiné. Cet arbre en a vu beaucoup."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राचीन और अनुभवी। इस पेड़ ने बहुत कुछ देखा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antico e segnato dal tempo. Quest'albero ne ha viste tante."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უძველესი და ქარგაცრეცილი. ამ ხეს ბევრი რამ უნახავს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senovinis ir vėjų nugairintas. Šis medis matė daug."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eldgammel og værbitt. Dette treet har sett mye."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oeroud en verweerd. Deze boom heeft veel meegemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pradawne i ogorzałe. To drzewo wiele widziało."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Древний и обветренный. Это дерево многое повидало."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прадавній і обвітрений. Це дерево багато бачило."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cổ kính và phong sương. Cây này đã trải qua nhiều điều."
          }
        }
      }
    },
