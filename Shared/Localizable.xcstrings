    "Full access to your garden, journal, health timeline, and savings. Free until your trial ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plný přístup k zahradě, deníku, zdravotní časové ose a úsporám. Zdarma až do konce zkušební doby."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voller Zugriff auf Garten, Tagebuch, Gesundheitsverlauf und Ersparnisse. Gratis bis zum Ende der Testphase."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πλήρης πρόσβαση σε κήπο, ημερολόγιο, χρονολόγιο υγείας και οικονομίες. Δωρεάν μέχρι το τέλος της δοκιμής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso completo a tu jardín, diario, cronología de salud y ahorros. Gratis hasta que termine la prueba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysi pääsy puutarhaan, päiväkirjaan, terveysaikajanaan ja säästöihin. Ilmainen kokeilun loppuun asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès complet au jardin, au journal, au calendrier santé et aux économies. Gratuit jusqu'à la fin de l'essai."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बग़ीचा, डायरी, सेहत की टाइमलाइन और बचत तक पूरी पहुँच। ट्रायल ख़त्म होने तक मुफ़्त।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso completo a giardino, diario, cronologia della salute e risparmi. Gratis fino alla fine della prova."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სრული წვდომა ბაღზე, დღიურზე, ჯანმრთელობის ქრონიკასა და დანაზოგზე. უფასოდ საცდელი პერიოდის ბოლომდე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa prieiga prie sodo, dienoraščio, sveikatos laiko juostos ir santaupų. Nemokamai iki bandomojo laikotarpio pabaigos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full tilgang til hage, dagbok, helsetidslinje og sparing. Gratis til prøveperioden er over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledige toegang tot je tuin, dagboek, gezondheidstijdlijn en besparingen. Gratis tot je proefperiode eindigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełny dostęp do ogrodu, dziennika, osi zdrowia i oszczędności. Za darmo do końca okresu próbnego."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный доступ к саду, дневнику, хронике здоровья и накоплениям. Бесплатно до конца пробного периода."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повний доступ до саду, щоденника, хроніки здоров’я та заощаджень. Безкоштовно до кінця пробного періоду."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn quyền dùng khu vườn, nhật ký, dòng thời gian sức khỏe và tiết kiệm. Miễn phí đến khi hết dùng thử."
          }
        }
      }
    },
