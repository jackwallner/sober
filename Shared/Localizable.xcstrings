    "A lacy maple in warm autumn red and gold. Star-shaped leaves drift down as the days add up." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krajkový javor v teplé podzimní červené a zlaté. Hvězdicovité listy padají, jak přibývají dny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein filigraner Ahorn in warmem Herbstrot und Gold. Sternförmige Blätter fallen, während die Tage zunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα δαντελωτό σφεντάμι σε ζεστό φθινοπωρινό κόκκινο και χρυσό. Φύλλα σαν αστέρια πέφτουν καθώς περνούν οι μέρες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arce de encaje en cálidos rojos y dorados otoñales. Sus hojas en forma de estrella caen según suman los días."
          }
        },
        "fi" : {
          "stringUnit" : {
