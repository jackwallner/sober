    "Billing starts. Cancel by then." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začne se účtovat. Do té doby můžeš zrušit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abbuchung beginnt. Kündige bis dahin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινά η χρέωση. Ακύρωσε ως τότε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza el cobro. Cancela antes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algab tasumine. Tühista enne seda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veloitus alkaa. Peru ennen sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La facturation commence. Annulez avant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिलिंग शुरू होने से पहले रद्द करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekkor indul a számlázás. Addig lemondhatod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte l'addebito. Annulla prima."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გადახდა იწყება. მანამდე გააუქმე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prasideda mokėjimai. Atšauk iki tol."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen trekkes da. Si opp abonnementet før det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaalt vanaf dan. Zeg vóór die tijd op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opłaty zaczną być naliczane. Anuluj wcześniej."
          }
        },
        "ro" : {
          "stringUnit" : {
