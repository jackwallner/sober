    "%@ Keep the full garden, or cancel any time before it renews." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ponech si celou zahradu, nebo předplatné kdykoli před obnovením zruš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Behalte den ganzen Garten oder kündige jederzeit vor der Verlängerung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Κράτα όλο τον κήπο ή ακύρωσε όποτε θες πριν την ανανέωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Conserva el jardín completo o cancela cuando quieras antes de la renovación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Jäta kogu aed alles või tühista igal ajal enne pikenemist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pidä koko puutarha tai peru milloin vain ennen uusimista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Gardez tout le jardin, ou annulez à tout moment avant le renouvellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पूरा बग़ीचा रखें, या रिन्यू होने से पहले कभी भी रद्द करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tartsd meg a teljes kertet, vagy mondd le bármikor a megújulás előtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Mantieni il giardino completo o annulla quando vuoi prima del rinnovo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ შეინარჩუნე მთელი ბაღი ან გააუქმე ნებისმიერ დროს განახლებამდე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Pasilik visą sodą arba atšauk bet kada prieš atnaujinimą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Behold hele hagen, eller avslutt når som helst før fornyelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Behoud de hele tuin of zeg op elk moment vóór de verlenging op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zachowaj cały ogród albo anuluj w dowolnej chwili przed odnowieniem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Păstrează toată grădina sau anulează oricând înainte de reînnoire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Сохраните весь сад или отмените в любой момент до продления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Behåll hela trädgården eller avsluta när som helst före förnyelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ใช้สวนได้ครบทุกฟีเจอร์ หรือยกเลิกได้ทุกเมื่อก่อนต่ออายุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bahçenin tamamını koru veya yenilenmeden önce istediğin zaman iptal et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Збережіть увесь сад або скасуйте будь-коли до поновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Giữ toàn bộ khu vườn, hoặc hủy bất cứ lúc nào trước khi gia hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 继续使用完整花园，或在续订前随时取消。"
          }
        }
      }
    },
