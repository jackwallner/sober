    "Log today and water your garden. You've got this." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapiš dnešek a zalij zahradu. Zvládneš to."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag den heutigen Tag ein und gieß deinen Garten. Du schaffst das."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατάγραψε τη σημερινή μέρα και πότισε τον κήπο σου. Τα καταφέρνεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra hoy y riega tu jardín. Tú puedes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane tänane päev kirja ja kasta oma aeda. Sa saad hakkama."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa tämä päivä ja kastele puutarhasi. Sinä pystyt tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez votre journée et arrosez votre jardin. Vous allez y arriver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज दर्ज करें और बग़ीचे को पानी दें। आप कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jegyezd fel a mai napot, és öntözd meg a kerted. Menni fog."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra la giornata di oggi e annaffia il tuo giardino. Ce la fai."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დღევანდელი დღე ჩაიწერე და ბაღი მორწყე. გამოგივა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pažymėk šiandieną ir palaistyk sodą. Tau pavyks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer dagen og vann hagen. Du klarer dette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registreer je dag als nuchter en geef je tuin water. Jij kunt dit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz dzisiejszy dzień i podlej ogród. Dasz radę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrează ziua de azi și udă-ți grădina. Poți face asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отметьте сегодня и полейте сад. У вас получится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrera dagen och vattna din trädgård. Du klarar det."
          }
