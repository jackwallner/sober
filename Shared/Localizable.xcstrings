    "Keep none at home for the first few weeks if you can." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud to jde, neměj první týdny doma nic."
