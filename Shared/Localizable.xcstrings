        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อารมณ์ที่บันทึกไว้ในช่วงก่อนเผลอดื่มต่ำกว่าปกติ ลองสังเกตไว้แต่เนิ่นๆ"
