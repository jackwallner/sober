    "One month without alcohol calories typically translates to several pounds of fat loss for moderate-to-heavy drinkers." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měsíc bez kalorií z alkoholu u středně až silně pijících obvykle znamená znatelný úbytek tuku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Monat ohne Alkoholkalorien führt bei mäßigem bis hohem Alkoholkonsum meist zu mehreren Pfund weniger Körperfett."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας μήνας χωρίς τις θερμίδες από το αλκοόλ συνήθως σημαίνει απώλεια μερικών κιλών λίπους για όσους έπιναν μέτριες έως μεγάλες ποσότητες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mes sin las calorías del alcohol suele traducirse en una pérdida de entre uno y dos kilos de grasa en quienes bebían de forma moderada o abundante."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mõõduka kuni rohke alkoholitarbimise korral tähendab kuu ilma alkoholist saadavate kaloriteta tavaliselt mitme naela võrra rasva vähenemist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuukausi ilman alkoholista saatavia kaloreita tarkoittaa kohtuullisesti tai runsaasti juoville yleensä muutaman kilon rasvan vähenemistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mois sans les calories apportées par l'alcool se traduit souvent par quelques kilos de graisse en moins chez les personnes ayant une consommation d'alcool modérée à élevée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मध्यम से ज़्यादा शराब पीने वालों में, शराब से मिलने वाली कैलोरी छोड़ने पर आम तौर पर एक महीने में कई पाउंड चर्बी घटती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mérsékelt vagy nagy mennyiségű alkoholfogyasztás esetén egy hónap alkoholból származó kalóriák nélkül jellemzően több fontnyi testzsírvesztést jelent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per chi beve quantità moderate o elevate, un mese senza le calorie dell'alcol di solito si traduce nella perdita di qualche chilo di grasso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ზომიერად ან ჭარბად მსმელებისთვის, ალკოჰოლური სასმელების კალორიების გარეშე გატარებული ერთი თვე, როგორც წესი, ცხიმის რამდენიმე ფუნტით კლებას ნიშნავს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žmonėms, kurie įprastai vartoja vidutiniškai ar daug alkoholio, mėnesį jo nevartojus kūno riebalų kiekis paprastai sumažėja maždaug kilogramu ar dviem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En måned uten alkoholkalorier gir som regel merkbart fettap for dem som drakk moderat til mye."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een maand zonder calorieën uit alcohol levert matige tot zware drinkers meestal een paar kilo vetverlies op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U osób pijących umiarkowanie lub dużo miesiąc bez kalorii pochodzących z alkoholu zwykle oznacza utratę 1 do 2 kilogramów tkanki tłuszczowej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru persoanele care consumă alcool în cantități moderate sau mari, o lună fără caloriile din alcool se traduce de obicei prin pierderea câtorva livre de grăsime."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месяц без алкоголя обычно помогает тем, кто пил умеренно или много, сбросить несколько фунтов жира."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En månad utan kalorier från alkohol leder ofta till ett par kilos fettminskning för den som druckit måttligt till mycket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับผู้ที่ดื่มปานกลางถึงมาก การงดแคลอรีจากแอลกอฮอล์หนึ่งเดือนโดยทั่วไปอาจทำให้ไขมันลดลงหลายปอนด์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkolden alınan kaloriler olmadan geçen bir ay, orta veya yüksek düzeyde içki içen kişilerde genellikle birkaç pound yağ kaybına karşılık gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місяць без калорій з алкоголю для тих, хто пив помірно чи багато, зазвичай означає помітну втрату жиру."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với người uống rượu bia ở mức vừa đến nhiều, một tháng không nạp calo từ rượu bia thường tương đương với việc giảm vài cân mỡ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于中度至重度饮酒者，一个月不摄入酒精热量通常意味着减少数磅体脂。"
          }
        }
      }
    },
    "One more logged craving and your patterns keep filling in." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě jedna zapsaná chuť a tvé vzorce se budou dál rýsovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag noch ein Verlangen ein, dann werden deine Muster klarer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία ακόμα καταγεγραμμένη λαχτάρα και τα μοτίβα σου συμπληρώνονται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con un antojo más registrado, tus patrones seguirán tomando forma."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel üks kirja pandud tung ja sinu mustrid täienevad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielä yksi kirjattu himo, niin toimintamallisi täydentyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore une envie notée et vos habitudes se précisent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक और तलब दर्ज होने पर आपके पैटर्न की तस्वीर और साफ़ होती जाएगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jegyezz fel még egy sóvárgást, és a mintáid tovább rajzolódnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora una voglia registrata e i tuoi schemi diventano sempre più chiari."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კიდევ ერთი ჩაწერილი ლტოლვის შემდეგ შენი ჩვევების სურათი უფრო გამოიკვეთება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar vienas pažymėtas potraukis, ir tavo dėsningumai taps dar aiškesni."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du registrerer ett sug til, blir mønstrene dine tydeligere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg nog één moment van trek in alcohol vast en je patronen worden steeds duidelijker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeszcze jeden zapisany moment głodu pomoże lepiej dostrzec twój schemat."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă o poftă înregistrată și tiparele tale devin mai clare."
          }
        },
        "ru" : {
