    "After work, with dinner, the moment it always used to happen." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po práci, u večeře, ve chvíli, kdy se dřív vždycky pilo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Arbeit, beim Abendessen, der Moment, in dem es immer passierte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά τη δουλειά, με το φαγητό, τη στιγμή που πάντα συνέβαινε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después del trabajo, con la cena, el momento en que siempre pasaba."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pärast tööd, õhtusöögi ajal, sel hetkel, kui see varem alati juhtus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töiden jälkeen, päivällisellä, se hetki, jolloin se aina tapahtui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le travail, au dîner, le moment où ça arrivait toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम के बाद, खाने के साथ, वह पल जब हमेशा ऐसा होता था।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munka után, vacsora közben, amikor korábban mindig megtörtént."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il lavoro, a cena, il momento in cui succedeva sempre."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სამსახურის შემდეგ, ვახშამზე, ის წამი, როცა ყოველთვის ხდებოდა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po darbo, per vakarienę, ta akimirka, kai visada taip būdavo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter jobb, til middag, akkurat når det pleide å skje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het werk, bij het eten, het moment waarop het altijd gebeurde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po pracy, przy kolacji, chwila, w której zawsze to się działo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După muncă, la cină, în momentul în care se întâmpla mereu."
          }
        },
        "ru" : {
          "stringUnit" : {
