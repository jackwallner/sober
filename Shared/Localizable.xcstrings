    "Two days in, cells finish rehydrating, headaches subside, and skin tone improves." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dvou dnech jsou buňky znovu hydratované, bolesti hlavy ustupují a pleť vypadá lépe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach zwei Tagen sind die Zellen wieder vollständig mit Flüssigkeit versorgt, Kopfschmerzen lassen nach und der Teint verbessert sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε δύο μέρες τα κύτταρα ενυδατώνονται ξανά, οι πονοκέφαλοι υποχωρούν και η επιδερμίδα βελτιώνεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A los dos días, las células terminan de rehidratarse, los dolores de cabeza remiten y el tono de la piel mejora."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahe päeva järel taastub rakkude vedelikutasakaal, peavalud leevenevad ja naha jume paraneb."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahden päivän jälkeen kehon nestetasapaino on palautunut, päänsäryt hellittävät ja ihon sävy paranee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au bout de deux jours, les cellules sont réhydratées, les maux de tête s'atténuent et le teint s'améliore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो दिन में कोशिकाओं में पानी लौट आता है, सिरदर्द कम होता है और त्वचा निखरती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Két nap után a sejtek hidratáltsága helyreáll, a fejfájás enyhül, és javul a bőr tónusa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo due giorni, le cellule completano la reidratazione, il mal di testa si attenua e il colorito migliora."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ორი დღის შემდეგ უჯრედების დატენიანება სრულდება, თავის ტკივილი ცხრება და კანის ფერი უმჯობესდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dviejų dienų ląstelės vėl hidratuotos, galvos skausmai atslūgsta, o odos spalva pagerėja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter to dager har cellene fått tilbake væsken, hodepinen gir seg og huden ser bedre ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na twee dagen zijn je cellen weer gehydrateerd, neemt hoofdpijn af en verbetert je teint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dwóch dniach komórki są znów nawodnione, bóle głowy słabną, a cera wygląda lepiej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După două zile, celulele se rehidratează complet, durerile de cap se reduc, iar aspectul pielii se îmbunătățește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через два дня клетки восстанавливают водный баланс, головные боли стихают, кожа выглядит лучше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter två dagar har cellerna återfått vätska, huvudvärken avtar och huden får en jämnare ton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังผ่านไปสองวัน เซลล์กลับมามีน้ำเพียงพอ อาการปวดหัวลดลง และสีผิวดีขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki günün sonunda hücreler yeniden sıvı kazanır, baş ağrıları hafifler ve cilt görünümü iyileşir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через два дні клітини відновлюють водний баланс, головний біль стихає, шкіра виглядає краще."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau hai ngày, các tế bào đã bù đủ nước, cơn đau đầu dịu đi và làn da cải thiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两天后，细胞完成水分补充，头痛减轻，肤色改善。"
          }
        }
      }
    },
    "Two quick questions while it's fresh. Both optional." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě rychlé otázky, dokud to máš v čerstvé paměti. Obě nepovinné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei kurze Fragen, solange es frisch ist. Beide freiwillig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δύο γρήγορες ερωτήσεις όσο το θυμάσαι ακόμα. Και οι δύο προαιρετικές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos preguntas rápidas, ahora que aún lo tienes presente. Ambas opcionales."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaks kiiret küsimust, kuni see on veel värskelt meeles. Mõlemad on vabatahtlikud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksi nopeaa kysymystä, kun se on tuoreessa muistissa. Molemmat vapaaehtoisia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux questions rapides tant que c'est frais. Toutes deux facultatives."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बात अभी ताज़ा है, इसलिए दो छोटे सवाल। दोनों वैकल्पिक हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Két gyors kérdés, amíg friss az élmény. Mindkettő kihagyható."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due domande veloci finché il ricordo è fresco. Entrambe facoltative."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ორი მოკლე კითხვა, სანამ ჯერ კიდევ გახსოვს. ორივე არასავალდებულოა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trumpi klausimai, kol prisimeni. Abu neprivalomi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To raske spørsmål mens det fortsatt er ferskt i minnet. Begge er valgfrie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee snelle vragen zolang het nog vers in je geheugen ligt. Allebei optioneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa szybkie pytania, póki pamiętasz. Oba opcjonalne."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Două întrebări rapide, cât încă îți amintești. Ambele sunt opționale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два коротких вопроса, пока свежо в памяти. Оба необязательны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två snabba frågor medan du har det färskt i minnet. Båda är frivilliga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สองคำถามสั้นๆ ขณะที่ยังจำได้ ทั้งสองข้อข้ามได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz aklındayken iki kısa soru. İkisi de isteğe bağlı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два коротких питання, поки свіже в пам’яті. Обидва необов’язкові."
          }
        },
        "vi" : {
