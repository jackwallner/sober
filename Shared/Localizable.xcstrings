    "What did I do today that my future self will thank me for?" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co jsem dnes udělal, za co mi budoucí já poděkuje?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was habe ich heute getan, wofür mir mein zukünftiges Ich danken wird?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι έκανα σήμερα για το οποίο θα με ευχαριστήσει ο μελλοντικός εαυτός μου;"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué hice hoy que mi yo del futuro me agradecerá?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mida ma täna tegin, mille eest tuleviku mina mind tänab?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä tein tänään sellaista, mistä tuleva minäni kiittää minua?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu'ai-je fait aujourd'hui dont je me remercierai plus tard ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज मैंने ऐसा क्या किया, जिसके लिए मैं आगे चलकर ख़ुद को धन्यवाद दूँगा?"
          }
        },
        "hu" : {
