        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψε το ένα πράγμα που σε βαραίνει και το επόμενο μικρό βήμα γι' αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe lo que más te pesa y el siguiente paso pequeño para resolverlo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane kirja üks asi, mis sind vaevab, ja järgmine väike samm selle lahendamiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita ylös se yksi asia, joka painaa, ja seuraava pieni askel sen suhteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez ce qui vous pèse et la prochaine petite étape pour y remédier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो बात आपको परेशान कर रही है, उसे लिखें और उससे निपटने का अगला छोटा कदम भी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írd le, mi nyomaszt, és mi lehet a következő apró lépés a megoldás felé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi una cosa che ti pesa e il prossimo piccolo passo per affrontarla."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩაიწერე ერთი რამ, რაც გაწუხებს, და შემდეგი პატარა ნაბიჯი, რომლის გადადგმაც შეგიძლია."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Užsirašyk tą vieną dalyką, kuris slegia, ir kitą mažą žingsnį."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ned det som tynger deg, og et lite steg du kan ta videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf op wat op je drukt en welke kleine stap je kunt zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz jedną rzecz, która cię przytłacza, i kolejny mały krok, który możesz w tej sprawie zrobić."
          }
