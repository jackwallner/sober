    "Decide when you're leaving before you arrive, and tell one person." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozhodni se, kdy odejdeš, ještě než dorazíš, a řekni to jednomu člověku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg fest, wann du gehst, bevor du ankommst, und sag es einer Person."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποφάσισε πότε θα φύγεις πριν φτάσεις και πες το σε έναν άνθρωπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide cuándo te irás antes de llegar y díselo a una persona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätä lähtöaikasi ennen kuin saavut ja kerro siitä yhdelle ihmiselle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décidez de l'heure de départ avant d'arriver et dites-le à une personne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहुँचने से पहले तय करें कि कब निकलेंगे और किसी एक को बता दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidi quando andartene prima di arrivare e dillo a una persona."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მისვლამდე გადაწყვიტე, როდის წახვალ, და ერთ ადამიანს უთხარი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš atvykdamas nuspręsk, kada išeisi, ir pasakyk vienam žmogui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestem når du går før du kommer, og si det til én person."
