    "The cascade style mimics a tree growing on a cliff, plunging downward." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskádový styl napodobuje strom rostoucí na útesu, který se sklání dolů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kaskadenstil ahmt einen Baum nach, der an einer Klippe nach unten wächst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το στυλ καταρράκτη μιμείται ένα δέντρο σε γκρεμό που γέρνει προς τα κάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estilo cascada imita a un árbol que crece en un acantilado y se inclina hacia abajo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskaadstiil jäljendab kaljul kasvavat puud, mille oksad langevad allapoole."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadityyli jäljittelee jyrkänteellä kasvavaa, alas syöksyvää puuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le style cascade évoque un arbre qui pousse à flanc de falaise et dont les branches retombent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झरना शैली चट्टान पर उगते, नीचे झुकते पेड़ जैसी दिखती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kaszkádstílus egy sziklafalon lefelé növő fát idéz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stile a cascata imita un albero che cresce su una scogliera e si sviluppa verso il basso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კასკადური სტილი კლდეზე ამოსულ, ქვემოთ დაშვებულ ხეს ჰბაძავს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadinis stilius primena ant uolos augantį, žemyn krentantį medį."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadestilen etterligner et tre på en klippe som stuper nedover."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cascadestijl bootst een boom na die op een klif groeit en naar beneden hangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl kaskadowy naśladuje drzewo rosnące na klifie i zwisające poniżej jego krawędzi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stilul cascadă imită un copac care crește pe o stâncă și coboară spre pământ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каскадный стиль напоминает дерево, которое растёт на скале и клонится вниз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadstilen efterliknar ett träd som växer nedåt från en klippa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทรงน้ำตกเลียนแบบต้นไม้ที่เติบโตห้อยลงมาจากหน้าผา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şelale stili, bir uçurumda aşağı doğru büyüyen ağacı taklit eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каскадний стиль нагадує дерево на скелі, що спадає донизу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểu thác đổ mô phỏng cây mọc trên vách đá, rủ xuống dưới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "悬崖式盆景模仿生长在峭壁上的树，枝干向下延伸。"
