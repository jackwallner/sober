    "Text one person. Even \"hey\" breaks the loop." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napiš jednomu člověku. I obyčejné „ahoj“ přeruší ten kolotoč."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib einer Person. Schon ein „Hey“ durchbricht die Schleife."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλε μήνυμα σε έναν άνθρωπο. Ακόμα κι ένα «γεια» σπάει τον κύκλο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbele a una persona. Hasta un «hola» rompe el bucle."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saada kellelegi sõnum. Isegi „hei” aitab mõtteringi katkestada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita viesti yhdelle ihmiselle. Pelkkä ”moi” katkaisee kierteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un message à quelqu'un. Même un « salut » casse la boucle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी एक व्यक्ति को मैसेज करें। सिर्फ़ “हाय” भी चक्र तोड़ देता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Írj valakinek. Már egy „szia” is megtöri a kört."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi a una persona. Anche un «ciao» basta a spezzare il circolo vizioso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მისწერე ერთ ადამიანს. თუნდაც „სალამი“ წრეს გაარღვევს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parašyk vienam žmogui. Net „labas“ nutraukia ratą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send melding til én person. Selv «hei» bryter mønsteret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur één persoon een bericht. Zelfs ‘hoi’ doorbreekt de cirkel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napisz do jednej osoby. Nawet „hej” przerywa pętlę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrie-i cuiva. Chiar și un «salut» poate rupe cercul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишите одному человеку. Даже «привет» разрывает круг."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka ett meddelande till någon. Även ett enkelt ”hej” kan bryta mönstret."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งข้อความหาใครสักคน แค่ทักว่า \"หวัดดี\" ก็ช่วยตัดวงจรนี้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birine mesaj at. Bir «merhaba» bile bu döngüyü kırar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напишіть одній людині. Навіть «привіт» розриває коло."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhắn tin cho một người. Chỉ một câu “chào” cũng phá được vòng lặp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给一个人发条消息。哪怕只说一句“嗨”，也能打断思绪。"
          }
        }
      }
    },
