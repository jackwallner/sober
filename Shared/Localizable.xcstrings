    "Today is fine. You can change this later." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klidně zvol dnešek. Později to můžeš změnit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute passt auch. Du kannst es später ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σημερινή κάνει μια χαρά. Μπορείς να την αλλάξεις αργότερα."
