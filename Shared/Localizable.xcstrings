        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब भी तैयार हों, पहला दिन इंतज़ार कर रहा है। पहले कोई सिलसिला दोबारा बनाने की ज़रूरत नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor készen állsz, vár az első nap. Nem kell előbb újraépítened a sorozatodat."
