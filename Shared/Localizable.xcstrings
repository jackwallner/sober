    "Whenever you're ready, day one is waiting. No streak to rebuild first." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až budeš připravený, čeká tě první den. Žádnou sérii nemusíš nejdřív obnovovat."
