          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sprekk kan bare angres så lenge den er den nyeste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een uitglijder kun je alleen terugdraaien als het de meest recente is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potknięcie można cofnąć tylko wtedy, gdy jest najnowsze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срыв можно отменить, только пока он самый последний."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зрив можна скасувати, лише поки він останній."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
