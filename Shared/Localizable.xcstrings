      }
    },
    "The days leading up to one read lower than your usual. Worth noticing early." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dny před ním vycházejí hůř než obvykle. Stojí za to si toho všimnout včas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tage davor liegen unter deinem Schnitt. Es lohnt sich, das früh zu bemerken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μέρες πριν από ένα παραπάτημα δείχνουν χαμηλότερες τιμές από ό,τι συνήθως. Αξίζει να το προσέξεις έγκαιρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores de los días previos a un desliz suelen ser más bajos de lo habitual. Conviene fijarse pronto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sellele eelnevate päevade näidud on sinu tavapärasest madalamad. Seda tasub varakult märgata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitä edeltävien päivien lukemat jäävät tavallista matalammiksi. Tämä kannattaa huomata ajoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les jours qui précèdent un écart, votre humeur est souvent plus basse que d'habitude. Mieux vaut le remarquer tôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उससे पहले के दिनों की रेटिंग आम दिनों से कम रहती है। इसे जल्दी पहचानना काम का है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előtte lévő napok értékei elmaradnak a megszokottól. Érdemes ezt korán észrevenni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nei giorni precedenti il tuo umore è più basso del solito. Vale la pena accorgersene presto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მის წინა დღეებში ჩვეულებრივზე დაბალი მაჩვენებლებია. ამის დროულად შემჩნევა ღირს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienomis prieš paslydimą tavo savijautos įvertinimai būna žemesni nei įprastai. Verta tai pastebėti iš anksto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagene før ligger lavere enn vanlig. Verdt å legge merke til tidlig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De dagen ervoor scoren lager dan normaal. Goed om vroeg op te merken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dni przed nim wypadają niżej niż zwykle. Warto to zauważyć wcześnie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În zilele dinainte să bei, starea ta de spirit tinde să fie mai proastă decât de obicei. Merită să observi asta din timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В дни перед тягой ваши показатели ниже обычного. Стоит замечать это заранее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagarna före ett sådant tillfälle ligger lägre än vanligt för dig. Bra att uppmärksamma i tid."
