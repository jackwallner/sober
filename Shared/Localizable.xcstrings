    "You've already saved %@ staying sober. Treat yourself to the tools that keep it growing." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Střízlivostí jsi už ušetřil %@. Dopřej si nástroje, díky kterým to poroste dál."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast schon %@ gespart, weil du nüchtern bleibst. Gönn dir die Werkzeuge, mit denen deine Ersparnisse weiter wachsen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις ήδη γλιτώσει %@ μένοντας νηφάλιος. Χάρισε στον εαυτό σου τα εργαλεία που το κάνουν να μεγαλώνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya ahorraste %@ al mantenerte sobrio. Regálate las herramientas que te ayudan a seguir ahorrando."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oled kainena püsimisega juba %@ säästnud. Luba endale vahendid, mis aitavad säästul kasvada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet jo säästänyt %@ raittiina. Hanki itsellesi työkalut, joilla se kasvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà économisé %@ en restant sobre. Offrez-vous les outils pour continuer sur cette lancée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संयम से आप पहले ही %@ बचा चुके हैं। अपनी बचत बढ़ाते रहने के लिए टूल आज़माएँ।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Józanul maradva már %@ összeget megtakarítottál. Szerezd meg az eszközöket, amelyekkel tovább gyarapíthatod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già risparmiato %@ restando sobrio. Regalati gli strumenti che lo fanno crescere."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სიფხიზლით უკვე დაზოგე %@. აჩუქე თავს ხელსაწყოები, რომ ეს ზრდა გაგრძელდეს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Būdamas blaivus jau sutaupei %@. Palepink save įrankiais, kurie padės toliau augti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har allerede spart %@ ved å holde deg edru. Unn deg verktøyene som hjelper deg å vokse videre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt al %@ bespaard door nuchter te blijven. Gun jezelf de tools die het laten groeien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki trzeźwości zaoszczędziłeś już %@. Spraw sobie narzędzia, które pomogą ci dalej oszczędzać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai economisit deja %@ rămânând fără alcool. Oferă-ți instrumentele care te ajută să economisești în continuare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставаясь трезвым, вы уже сэкономили %@. Откройте инструменты, которые помогут сэкономить ещё больше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har redan sparat %@ genom att vara nykter. Unna dig verktygen som hjälper besparingarna att växa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณประหยัดได้แล้ว %@ จากการไม่ดื่ม มอบเครื่องมือที่จะช่วยให้เงินออมเติบโตต่อไปให้ตัวเอง"
          }
