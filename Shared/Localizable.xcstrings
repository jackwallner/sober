    "Stays in your pocket, not on alcohol. Bloom+ keeps the streak that gets you there." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zůstane ti v kapse, ne v alkoholu. Bloom+ drží sérii, která tě tam dovede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt in deiner Tasche statt im Alkohol. Bloom+ hält die Serie, die dich dorthin bringt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μένουν στην τσέπη σου, όχι στο αλκοόλ. Το Bloom+ κρατά το σερί που σε φτάνει εκεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en tu bolsillo, no en alcohol. Bloom+ sostiene la racha que te lleva hasta ahí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jää taskuusi eikä alkoholiin. Bloom+ pitää yllä putkea, joka vie sinut sinne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste dans votre poche, pas dans l'alcool. Bloom+ entretient la série qui vous y mène."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शराब पर नहीं, आपकी जेब में रहता है। Bloom+ वह सिलसिला बनाए रखता है जो आपको वहाँ ले जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta in tasca, non nell'alcol. Bloom+ sostiene la serie che ti porta lì."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჯიბეში რჩება და არა ალკოჰოლზე. Bloom+ ინარჩუნებს სერიას, რომელიც იქამდე მიგიყვანს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieka kišenėje, ne alkoholiui. Bloom+ palaiko seriją, kuri tave ten nuves."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir i lomma, ikke i alkohol. Bloom+ holder rekken som tar deg dit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijft in je zak, niet in alcohol. Bloom+ houdt de reeks vast die je daar brengt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaje w kieszeni, a nie w alkoholu. Bloom+ podtrzymuje serię, która cię tam doprowadzi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остаётся в кармане, а не уходит на алкоголь. Bloom+ поддерживает серию, которая к этому ведёт."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишається в кишені, а не йде на алкоголь. Bloom+ підтримує серію, що до цього веде."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở lại trong túi bạn, không phải vào rượu bia. Bloom+ giữ chuỗi ngày đưa bạn tới đó."
          }
        }
      }
    },
