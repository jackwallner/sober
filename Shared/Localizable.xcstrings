          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन गिनें, एक निजी बोनसाई उगाएँ और देखें शरीर व बटुए को क्या वापस मिलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta ogni giorno, fai crescere un bonsai privato e scopri cosa recuperano corpo e portafoglio."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
