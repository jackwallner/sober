    "Slept a full eight hours for the first time in years. That alone is worth it." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprvé po letech jsem spal celých osm hodin. Už jen to za to stojí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum ersten Mal seit Jahren volle acht Stunden geschlafen. Allein das lohnt sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοιμήθηκα ολόκληρες οκτώ ώρες για πρώτη φορά εδώ και χρόνια. Και μόνο αυτό αξίζει τον κόπο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormí ocho horas seguidas por primera vez en años. Solo eso ya vale la pena."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magasin esimest korda aastate jooksul kaheksa tundi järjest. Juba see on seda väärt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nukuin täydet kahdeksan tuntia ensimmäistä kertaa vuosiin. Jo se on sen arvoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai dormi huit heures d'affilée pour la première fois depuis des années. Rien que pour ça, ça vaut le coup."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सालों में पहली बार पूरे आठ घंटे की नींद ली। सिर्फ़ इसी से सब सार्थक हो गया।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évek óta először aludtam végig nyolc órát. Már ezért megéri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho dormito otto ore piene per la prima volta da anni. Già solo questo ne vale la pena."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წლების შემდეგ პირველად მეძინა სრული რვა საათი. მარტო ამადაც ღირდა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirmą kartą per daug metų išmiegojau visas aštuonias valandas. Jau vien dėl to verta."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sov hele åtte timer for første gang på flere år. Bare det er verdt det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het eerst in jaren acht uur aan één stuk geslapen. Alleen dat al is het waard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszy raz od lat przespałem całe osiem godzin. Już samo to jest tego warte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am dormit opt ore întregi pentru prima dată după ani de zile. Chiar și numai pentru asta merită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впервые за много лет проспал целых восемь часов. Одно это уже того стоит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sov hela åtta timmar för första gången på flera år. Bara det är värt det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้นอนเต็มแปดชั่วโมงเป็นครั้งแรกในรอบหลายปี แค่นี้ก็คุ้มแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yıllar sonra ilk kez tam sekiz saat uyudum. Sırf bunun için bile değer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уперше за багато років вдалося проспати всі вісім годин. І це того варте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
