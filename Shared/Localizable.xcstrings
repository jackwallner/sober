    "Change rooms or step outside for five minutes. Urges are tied to the place they usually happen." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejdi do jiné místnosti nebo jdi na pět minut ven. Chutě jsou vázané na místo, kde obvykle přicházejí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle den Raum oder geh fünf Minuten raus. Verlangen hängt am Ort, an dem es meist auftaucht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε δωμάτιο ή βγες έξω για πέντε λεπτά. Η λαχτάρα συνδέεται με το μέρος που συνήθως εμφανίζεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia de habitación o sal cinco minutos. Las ganas están ligadas al lugar donde suelen aparecer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda huonetta tai mene ulos viideksi minuutiksi. Himot ovat sidoksissa paikkaan, jossa ne yleensä iskevät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de pièce ou sortez cinq minutes. Les envies sont liées au lieu où elles surviennent d'habitude."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कमरा बदलें या पाँच मिनट बाहर चले जाएँ। तलब उस जगह से जुड़ी होती है जहाँ वह आमतौर पर आती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia stanza o esci per cinque minuti. Le voglie sono legate al posto in cui di solito arrivano."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეიცვალე ოთახი ან ხუთი წუთით გარეთ გადი. ლტოლვა იმ ადგილთანაა დაკავშირებული, სადაც ჩვეულებრივ ჩნდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakeisk kambarį arba išeik penkioms minutėms į lauką. Potraukiai susiję su vieta, kur jie paprastai užeina."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt rom eller gå ut i fem minutter. Sug henger sammen med stedet de pleier å komme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga naar een andere kamer of vijf minuten naar buiten. Drang hangt vast aan de plek waar die meestal opkomt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień pokój lub wyjdź na pięć minut. Głód jest związany z miejscem, w którym zwykle przychodzi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смените комнату или выйдите на пять минут. Тяга привязана к месту, где она обычно возникает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть кімнату або вийдіть на п’ять хвилин. Потяг прив’язаний до місця, де він зазвичай виникає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
