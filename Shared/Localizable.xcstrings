    "You don't have to do anything else right now. Just stay here and breathe." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď nemusíš dělat nic jiného. Jen tu zůstaň a dýchej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst gerade nichts anderes tun. Bleib einfach hier und atme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται να κάνεις τίποτα άλλο τώρα. Απλώς μείνε εδώ και ανάπνεε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no tienes que hacer nada más. Solo quédate aquí y respira."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa ei pea praegu midagi muud tegema. Ole lihtsalt siin ja hinga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun ei tarvitse tehdä nyt mitään muuta. Pysy vain tässä ja hengitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez rien d'autre à faire pour l'instant. Restez là et respirez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी आपको और कुछ करने की ज़रूरत नहीं। बस यहीं रहें और साँस लें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most semmi mást nem kell tenned. Maradj itt, és lélegezz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adesso non devi fare nient'altro. Resta qui e respira."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ახლა სხვა არაფრის გაკეთება არ გჭირდება. უბრალოდ აქ დარჩი და ისუნთქე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabar nieko kito daryti nereikia. Tiesiog būk čia ir kvėpuok."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke gjøre noe annet nå. Bare bli her og pust."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft nu niets anders te doen. Blijf gewoon hier en adem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz nie musisz robić nic więcej. Po prostu zostań tu i oddychaj."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu trebuie să faci nimic altceva acum. Rămâi aici și respiră."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас больше ничего делать не нужно. Просто побудьте здесь и дышите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inte göra något annat just nu. Stanna bara här och andas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้คุณไม่ต้องทำอะไรอีก แค่อยู่ตรงนี้และหายใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda başka bir şey yapman gerekmiyor. Burada kal ve nefes al."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз більше нічого робити не треба. Просто побудьте тут і дихайте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lúc này bạn không cần làm gì khác. Chỉ cần ở đây và thở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在你不必做别的。就在这里，慢慢呼吸。"
          }
        }
      }
    },
