    "Walk for ten minutes. Moving burns off the edge the urge rides on." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jdi se na deset minut projít. Pohyb ti pomůže zmírnit nutkání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh zehn Minuten spazieren. Bewegung nimmt dem Verlangen die Spitze."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περπάτα για δέκα λεπτά. Η κίνηση εκτονώνει την ένταση που τροφοδοτεί τη λαχτάρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina diez minutos. Moverte le quita intensidad al impulso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaluta kümme minutit. Liikumine aitab tungiga kaasnevat rahutust leevendada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kävele kymmenen minuuttia. Liikkuminen voi helpottaa himoon liittyvää levottomuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marchez dix minutes. Bouger aide à faire retomber la tension liée à l'envie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दस मिनट टहलें। चलने से तलब के साथ आने वाली बेचैनी कम होती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sétálj tíz percet. A mozgás enyhítheti a késztetéssel járó feszültséget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina per dieci minuti. Muoversi aiuta a scaricare la tensione che alimenta la voglia."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ათი წუთი იარე. მოძრაობა ლტოლვის სიმწვავეს ამცირებს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pavaikščiok dešimt minučių. Judėjimas sumažina įtampą, kuri skatina potraukį."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå en tur i ti minutter. Bevegelse tar brodden av suget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandel tien minuten. Bewegen kan de drang wat afzwakken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejdź się przez dziesięć minut. Ruch pomaga rozładować napięcie związane z głodem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mergi pe jos zece minute. Mișcarea ajută la eliberarea tensiunii care însoțește impulsul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройдитесь десять минут. Движение снимает остроту тяги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå en promenad i tio minuter. Rörelse kan ta udden av impulsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เดินสักสิบนาที การเคลื่อนไหวช่วยให้แรงกระตุ้นให้อยากดื่มเบาลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On dakika yürü. Hareket etmek isteğin şiddetini azaltır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройдіться десять хвилин. Рух знімає напругу, на якій тримається потяг."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đi bộ mười phút. Vận động làm dịu sự bức bối mà cơn thèm bám vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "散步十分钟。活动身体有助于缓解冲动带来的紧绷感。"
          }
        }
      }
    },
    "We remind you before it ends." : {
