    "Make a soda water with lime, or something warm, and keep it in your hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dej si sodovku s limetkou nebo něco teplého a měj sklenici v ruce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach dir ein Sprudelwasser mit Limette oder etwas Warmes und behalt es in der Hand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε μια σόδα με λάιμ ή κάτι ζεστό και κράτα το στο χέρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate un vaso de agua con gas y lima, o algo caliente, y tenlo en la mano."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Võta laimiga mullivett või midagi sooja ja hoia jooki käes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota limetillä maustettua kivennäisvettä tai jotain lämmintä ja pidä sitä kädessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez une eau pétillante au citron vert ou une boisson chaude, et gardez-la en main."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींबू सोडा या कोई गर्म पेय बनाकर हाथ में रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Készíts egy lime-os szódavizet vagy egy meleg italt, és tartsd a kezedben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparati un'acqua frizzante con lime o qualcosa di caldo e tienila in mano."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოიმზადე გაზიანი წყალი ლაიმით ან რაიმე თბილი სასმელი და ხელში გეჭიროს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasidaryk gazuoto vandens su laimu ar ko nors šilto ir laikyk rankoje."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta et glass farris med lime eller noe varmt å drikke, og hold det i hånden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem een glas bruiswater met limoen of iets warms en houd het in je hand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób sobie wodę gazowaną z limonką albo coś ciepłego i trzymaj w ręce."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregătește o apă minerală cu lime sau o băutură caldă și ține-o în mână."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налейте себе газированной воды с лаймом или возьмите тёплый напиток и держите его в руке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta ett glas kolsyrat vatten med lime eller något varmt och håll det i handen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เตรียมโซดามะนาวหรือเครื่องดื่มอุ่นๆ แล้วถือไว้ในมือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limonlu bir soda veya sıcak bir içecek hazırla ve elinde tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налийте газовану воду з лаймом або теплий напій і тримайте склянку в руці."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuẩn bị một ly soda chanh hoặc thức uống ấm rồi cầm trên tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给自己准备一杯加青柠的苏打水或热饮，拿在手里。"
          }
        }
      }
