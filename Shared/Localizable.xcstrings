    "Celebrate with something you'll remember: the food, dessert, a photo." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslav to něčím, co si zapamatuješ: jídlem, dezertem, fotkou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feiere mit etwas, das dir in Erinnerung bleibt: einem Essen, einem Dessert oder einem Foto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γιόρτασε με κάτι που θα θυμάσαι: το φαγητό, το γλυκό, μια φωτογραφία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebra con algo que recordarás: la comida, el postre, una foto."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tähista millegi meeldejäävaga: hea toit, magustoit või foto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juhli jollakin mieleenpainuvalla, kuten ruoalla, jälkiruoalla tai valokuvalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Célébrez avec ce dont vous vous souviendrez : le repas, le dessert, une photo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसी चीज़ से जश्न मनाएँ जो याद रहे: खाना, मिठाई, एक तस्वीर।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ünnepelj valami emlékezetessel: egy étellel, desszerttel vagy fényképpel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festeggia con qualcosa che ricorderai: il cibo, il dolce, una foto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "იზეიმე ისეთი რამით, რაც დაგამახსოვრდება: კერძით, დესერტით ან ფოტოთი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Švęsk tuo, ką prisiminsi: maistu, desertu, nuotrauka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feir med noe du vil huske: maten, desserten eller et bilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier het met iets wat je onthoudt: het eten, het toetje, een foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczcij to czymś, co zapamiętasz: jedzeniem, deserem lub zdjęciem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sărbătorește cu ceva ce îți vei aminti: mâncarea, desertul, o fotografie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Празднуйте тем, что запомнится: едой, десертом, фото."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fira med något du kommer att minnas: maten, desserten eller ett foto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฉลองด้วยสิ่งที่คุณจะจดจำ เช่น อาหาร ของหวาน หรือภาพถ่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlayacağın bir şeyle kutla: bir yemek, tatlı veya fotoğraf."
          }
        },
        "uk" : {
