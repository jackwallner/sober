    "Shaped by a lifetime of wind. Every branch tells a story of endurance." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vítr ji tvaroval celý život. Každá větev vypráví příběh vytrvalosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geformt von einem Leben voller Wind. Jeder Ast erzählt von Ausdauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σμιλεμένο από τους ανέμους μιας ολόκληρης ζωής. Κάθε κλαδί λέει μια ιστορία αντοχής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moldeado por toda una vida de viento. Cada rama cuenta una historia de resistencia."
          }
        },
        "et" : {
          "stringUnit" : {
