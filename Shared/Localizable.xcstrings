    "Used to estimate money and calories saved while you stay sober." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží k odhadu ušetřených peněz a kalorií, dokud zůstáváš střízlivý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit schätzen wir, wie viel Geld und wie viele Kalorien du sparst, solange du nüchtern bleibst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για να εκτιμηθούν τα χρήματα και οι θερμίδες που γλιτώνεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve para estimar el dinero y las calorías que ahorras mientras sigues sobrio."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle põhjal hinnatakse, kui palju raha ja kaloreid sa kainena säästad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään arvioimaan, paljonko rahaa ja kaloreita säästät raittiina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à estimer l'argent et les calories économisés tant que vous restez sobre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संयम के दौरान बचे पैसे और कैलोरी का अनुमान लगाने के लिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek alapján becsüljük meg, mennyi pénzt és kalóriát takarítasz meg, amíg józan maradsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve a stimare il denaro e le calorie risparmiati mentre resti sobrio."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოიყენება ფხიზლად ყოფნისას დაზოგილი ფულისა და კალორიების შესაფასებლად."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudojama įvertinti, kiek pinigų ir kalorijų sutaupai būdamas blaivus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å anslå penger og kalorier du sparer mens du holder deg edru."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee schatten we hoeveel geld en calorieën je bespaart terwijl je nuchter blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do oszacowania pieniędzy i kalorii, które oszczędzasz, pozostając trzeźwym."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru estimarea banilor economisiți și a caloriilor evitate cât timp nu bei alcool."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы оценить, сколько денег и калорий вы экономите, оставаясь трезвым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att uppskatta hur mycket pengar och kalorier du sparar när du håller dig nykter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ประมาณเงินที่ประหยัดได้และแคลอรีที่ลดลงระหว่างที่คุณไม่ดื่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alkolsüz kaldığın sürede biriktirdiğin para ve almadığın kaloriyi tahmin etmek için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це допомагає оцінити, скільки грошей і калорій ви заощаджуєте, залишаючись тверезим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng để ước tính số tiền và calo bạn tiết kiệm khi giữ tỉnh táo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于估算戒酒期间节省的钱和减少的卡路里摄入量。"
          }
        }
      }
    },
