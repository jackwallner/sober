    "Keep your full garden, journal, and savings, or cancel any time before it renews." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponech si celou zahradu, deník i úspory, nebo předplatné kdykoli před obnovením zruš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte den vollen Zugriff auf Garten, Tagebuch und Ersparnisse oder kündige jederzeit vor der Verlängerung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα ολόκληρο τον κήπο, το ημερολόγιο και τις οικονομίες σου ή ακύρωσε πριν την ανανέωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva tu jardín completo, tu diario y tus ahorros, o cancela cuando quieras antes de que se renueve."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilita kogu oma aed, päevik ja sääst või tühista igal ajal enne tellimuse uuenemist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä koko puutarha, päiväkirja ja säästöt tai peru ennen uusimista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez l'accès complet au jardin, au journal et au suivi de vos économies, ou annulez avant le renouvellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना पूरा बग़ीचा, डायरी और बचत रखें, या रिन्यू होने से पहले रद्द करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őrizd meg a teljes kertedet, naplódat és megtakarításodat, vagy mondd le bármikor a megújulás előtt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni l'accesso completo al giardino, al diario e ai risparmi, oppure annulla quando vuoi prima del rinnovo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეინარჩუნე სრული ბაღი, დღიური და დანაზოგი, ან გამოწერა განახლებამდე ნებისმიერ დროს გააუქმე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasilik visą sodą, dienoraštį ir santaupas arba atšauk prieš atnaujinimą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold hele hagen, dagboken og sparingen, eller avslutt når som helst før fornyelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoud je volledige tuin, dagboek en besparingen, of zeg op vóór de verlenging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj ogród, dziennik i oszczędności albo anuluj przed odnowieniem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează accesul complet la grădină, jurnal și economii sau anulează oricând înainte de reînnoire."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните сад, дневник и накопления или отмените до продления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behåll hela trädgården, dagboken och dina besparingar, eller avsluta när som helst före förnyelsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้สวน บันทึก และสถิติเงินที่ประหยัดได้อย่างเต็มรูปแบบต่อไป หรือยกเลิกได้ทุกเมื่อก่อนต่ออายุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahçene, günlüğüne ve birikim takibine tam erişimini koru veya yenilenmeden önce istediğin zaman iptal et."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть увесь сад, щоденник і заощадження або скасуйте будь-коли до поновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ toàn bộ khu vườn, nhật ký và phần theo dõi tiền tiết kiệm, hoặc hủy bất cứ lúc nào trước khi gia hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续使用完整的花园、日记和节省记录，或在续订前随时取消。"
          }
        }
      }
    },
