    "Whenever you're ready, day one is waiting. No streak to rebuild first." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až budeš připravený, den jedna čeká. Žádnou sérii nemusíš nejdřív obnovovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann immer du bereit bist, wartet Tag eins. Keine Serie, die du erst aufbauen musst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όποτε είσαι έτοιμος, η πρώτη μέρα περιμένει. Δεν χρειάζεται να ξαναχτίσεις σερί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando estés listo, el día uno te espera. No hay racha que reconstruir antes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun olet valmis, ensimmäinen päivä odottaa. Putkea ei tarvitse rakentaa ensin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous serez prêt, le jour un vous attend. Aucune série à reconstruire avant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब भी तैयार हों, पहला दिन इंतज़ार कर रहा है। पहले कोई सिलसिला दोबारा बनाने की ज़रूरत नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando sei pronto, il primo giorno ti aspetta. Nessuna serie da ricostruire prima."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როცა მზად იქნები, პირველი დღე გელოდება. ჯერ სერიის აღდგენა არ გჭირდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai būsi pasiruošęs, pirma diena laukia. Jokios serijos atkurti nereikia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er klar, venter dag én. Ingen rekke å bygge opp igjen først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je er klaar voor bent, wacht dag één. Geen reeks om eerst weer op te bouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy tylko będziesz gotowy, dzień pierwszy czeka. Nie musisz najpierw odbudowywać serii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда будете готовы, день первый ждёт. Восстанавливать серию заранее не нужно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли будете готові, день перший чекає. Відновлювати серію заздалегідь не треба."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
