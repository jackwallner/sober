            "value" : "რამის გადაწყვეტამდე სამი წუთი ისუნთქე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš priimdamas sprendimą, tris minutes pakvėpuok."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pust i tre minutter før du bestemmer noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adem eerst drie minuten rustig voordat je iets beslist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddychaj przez trzy minuty, zanim cokolwiek zdecydujesz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respiră timp de trei minute înainte să iei orice decizie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подышите три минуты, прежде чем что-то решать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andas i tre minuter innan du bestämmer något."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองฝึกหายใจสามนาทีก่อนตัดสินใจทำอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir karar vermeden önce üç dakika nefes egzersizi yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подихайте три хвилини, перш ніж щось вирішувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hít thở ba phút trước khi quyết định bất cứ điều gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做三分钟呼吸练习，再做决定。"
          }
        }
      }
    },
