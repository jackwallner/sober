    "This is near the top of it. Cravings climb fast and then they stop climbing." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď je to skoro na vrcholu. Chutě rychle stoupají a pak stoupat přestanou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist fast der Höhepunkt. Verlangen steigt schnell und hört dann auf zu steigen."
