    "Free until %@. We'll remind you before it ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarma do %@, před koncem ti to připomeneme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis %@ kostenlos. Wir erinnern dich, bevor die Testphase endet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν έως %@, θα σου το θυμίσουμε πριν λήξει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis hasta el %@. Te avisaremos antes de que termine."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasuta kuni %@. Tuletame enne lõppu meelde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen %@ asti. Muistutamme ennen kuin kokeilu päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit jusqu'au %@. Nous vous préviendrons avant la fin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तक मुफ़्त। ख़त्म होने से पहले हम याद दिलाएँगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingyenes eddig: %@. A vége előtt emlékeztetünk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis fino al %@. Ti avviseremo prima della fine."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უფასოა %@-მდე. დასრულებამდე შეგახსენებთ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemokamai iki %@. Priminsime prieš pabaigą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis til %@. Vi minner deg på det før prøveperioden utløper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis tot %@. We herinneren je er op tijd aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za darmo do %@, przypomnimy przed końcem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit până la %@. Îți vom aminti înainte să se încheie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно до %@. Мы напомним заранее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis till %@. Vi påminner dig innan provperioden slutar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟรีจนถึง %@ เราจะเตือนคุณก่อนสิ้นสุด"
