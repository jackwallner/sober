    "Three months sober, resting heart rate decreases and arterial stiffness improves." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po třech měsících střízlivosti klesá klidová tepová frekvence a tepny jsou pružnější."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach drei nüchternen Monaten sinkt der Ruhepuls und die Gefäße werden elastischer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε τρεις μήνες νηφαλιότητας, οι παλμοί σε ηρεμία μειώνονται και οι αρτηρίες γίνονται πιο ελαστικές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A los tres meses sobrio, el pulso en reposo baja y mejora la rigidez arterial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolmen raittiin kuukauden jälkeen leposyke laskee ja valtimot joustavat paremmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après trois mois de sobriété, la fréquence au repos baisse et les artères gagnent en souplesse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीन महीने के संयम में आराम की हृदय गति घटती है और धमनियाँ लचीली होती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo tre mesi di sobrietà la frequenza a riposo cala e le arterie diventano più elastiche."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სამი ფხიზელი თვის შემდეგ მოსვენებული პულსი იკლებს და არტერიები უფრო ელასტიკური ხდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po trijų blaivių mėnesių ramybės pulsas sumažėja, o arterijos tampa elastingesnės."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter tre edru måneder synker hvilepulsen og årene blir mer elastiske."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na drie maanden nuchter daalt de hartslag in rust en worden de slagaders soepeler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po trzech miesiącach trzeźwości tętno spoczynkowe spada, a tętnice stają się bardziej elastyczne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через три трезвых месяца пульс в покое снижается, а артерии становятся эластичнее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через три тверезі місяці пульс у спокої знижується, а артерії стають еластичнішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau ba tháng tỉnh táo, nhịp tim lúc nghỉ giảm và động mạch dẻo dai hơn."
          }
        }
      }
    },
