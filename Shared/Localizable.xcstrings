        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უკვე ნაკლებია, ვიდრე ერთი წუთის წინ, თუნდაც დასრულებულად არ გეჩვენებოდეს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
