        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თუ დღეს ფხიზელი ხარ, ეს დღე ჩაიწერე და მორწყე ბაღი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jei šiandien blaivus, pažymėk ir palaistyk sodą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du holder deg edru i dag, registrer dagen og vann hagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is vandaag een nuchtere dag, leg hem dan vast en geef je tuin water."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli dziś jesteś trzeźwy, zapisz to i podlej ogród."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă azi e o zi fără alcool, înregistreaz-o și udă-ți grădina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если сегодня трезвый день, отметьте его и полейте сад."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du är nykter i dag, registrera dagen och vattna din trädgård."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าวันนี้คุณไม่ดื่ม บันทึกไว้แล้วรดน้ำสวนกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
