    "Tell the host or one friend ahead of time, so nobody pushes." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni to předem hostiteli nebo jednomu příteli, ať nikdo nenaléhá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag es vorher dem Gastgeber oder einem Freund, damit niemand drängt."
