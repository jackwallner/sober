        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando sei pronto, il primo giorno ti aspetta. Nessuna serie da ricostruire prima."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როცა მზად იქნები, პირველი დღე გელოდება. ჯერ სერიის აღდგენა არ გჭირდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai būsi pasiruošęs, pirma diena laukia. Jokios serijos atkurti nereikia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du er klar, venter dag én. Ingen rekke å bygge opp igjen først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je er klaar voor bent, wacht dag één. Geen reeks om eerst weer op te bouwen."
