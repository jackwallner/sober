        }
      }
    },
    "An evergreen pine with cloud-like needle tiers and a gnarled, weathered trunk." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stálezelená borovice s patry jehlic jako mraky a sukovitým, ošlehaným kmenem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine immergrüne Kiefer mit wolkenartigen Nadelstufen und knorrigem, verwittertem Stamm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα αειθαλές πεύκο με στρώσεις βελόνων σαν σύννεφα και ροζιασμένο, φθαρμένο κορμό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pino perenne con capas de agujas como nubes y un tronco nudoso y curtido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikivihreä mänty pilvimäisine neulaskerroksineen ja kyhmyisine, sään pieksemine runkoineen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pin persistant aux étages d'aiguilles en nuages et au tronc noueux, patiné."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बादल जैसी सुइयों की परतों और गाँठदार, पुराने तने वाला सदाबहार चीड़।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pino sempreverde con palchi di aghi come nuvole e un tronco nodoso e segnato dal tempo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მარადმწვანე ფიჭვი ღრუბლისებრი წიწვის იარუსებითა და კვანძიანი, ქარგაცრეცილი ღეროთი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visžalė pušis su debesis primenančiais spyglių aukštais ir gumbuotu, vėjų nugairintu kamienu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eviggrønn furu med skylignende nåletrinn og en knudrete, værbitt stamme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een groenblijvende den met wolkachtige naaldlagen en een knoestige, verweerde stam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zimozielona sosna z piętrami igieł jak chmury i sękatym, ogorzałym pniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечнозелёная сосна с ярусами хвои, похожими на облака, и узловатым обветренным стволом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вічнозелена сосна з ярусами хвої, схожими на хмари, і вузлуватим обвітреним стовбуром."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cây thông xanh quanh năm với tầng lá kim như mây và thân cây xù xì phong sương."
          }
        }
      }
    },
