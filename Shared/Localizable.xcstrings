        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ახლა თითქმის პიკზეა. ლტოლვა სწრაფად მატულობს და მერე მატებას წყვეტს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai beveik aukščiausias taškas. Potraukiai greitai stiprėja, paskui pasiekia piką."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suget nærmer seg toppen. Det stiger raskt, men så flater det ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is bijna het hoogtepunt. De drang neemt snel toe en vlakt dan af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
