    "Measured from the sessions you stayed with, not an average of everyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vychází z tvých sezení, která jsi zvládl, ne z průměru ostatních."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen an den Atemübungen, bei denen du drangeblieben bist, nicht am Durchschnitt aller."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετριέται από τις δικές σου συνεδρίες, όχι από τον μέσο όρο όλων."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medido a partir de las sesiones que seguiste hasta el final, no de un promedio general."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvestatud sinu lõpuni tehtud seansside, mitte kõigi kasutajate keskmise põhjal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitattu omista selätetyistä kerroistasi, ei kaikkien keskiarvosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesuré d'après les séances que vous avez suivies jusqu'au bout, pas d'après une moyenne générale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पूरे किए गए सत्रों के आधार पर मापा गया है, सबके औसत से नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azokból a gyakorlatokból számolva, amelyeket végigcsináltál, nem mindenki átlagából."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misurato in base alle sessioni che hai seguito, non alla media di tutti."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გამოთვლილია შენი ბოლომდე გავლილი სესიებით და არა ყველას საშუალოთი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apskaičiuota pagal sesijas, kurias išbuvai iki galo, o ne pagal visų naudotojų vidurkį."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målt ut fra øktene du fullførte, ikke gjennomsnittet for alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeten op basis van de sessies die je zelf hebt volgehouden, niet op een gemiddelde van iedereen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na podstawie sesji, które ukończyłeś, a nie średniej dla wszystkich."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculat din sesiunile pe care le-ai dus până la capăt, nu din media tuturor utilizatorilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассчитано по сессиям, которые вы прошли до конца, а не по среднему значению для всех."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baserat på dina fullföljda sessioner, inte ett genomsnitt för alla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วัดจากช่วงที่คุณรับมือกับความอยากดื่มจนจบ ไม่ใช่ค่าเฉลี่ยของทุกคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkesin ortalamasına göre değil, devam ettiğin seanslara göre ölçülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розраховано за сесіями, які ви пройшли до кінця, а не за середнім показником для всіх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính từ những lần bạn đã trụ vững, không phải trung bình của mọi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你坚持完成的呼吸练习计算，而非所有人的平均值。"
          }
        }
      }
    },
