        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसी कोई स्थिति बताएँ जिसमें पहले पीना शामिल था। मैंने उसे कैसे सँभाला?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensa a una situazione in cui prima si beveva. Come l'ho gestita?"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დაასახელე სიტუაცია, სადაც ადრე სვამდი. როგორ გაართვი თავი?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvardyk situaciją, kurioje anksčiau gerdavai. Kaip su ja susitvarkiau?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevn en situasjon som pleide å handle om drikking. Hvordan taklet jeg den?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noem een situatie waarin vroeger werd gedronken. Hoe ging ik ermee om?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymień sytuację, w której kiedyś się piło. Jak sobie z nią poradziłem?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назовите ситуацию, где раньше была выпивка. Как я с ней справился?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назвіть ситуацію, де раніше була випивка. Як я з нею впорався?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nêu một tình huống từng gắn với việc uống. Tôi đã vượt qua nó ra sao?"
          }
        }
      }
    },
    "Name it out loud: \"This is stress looking for a way out.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojmenuj to nahlas: „Tohle je stres, který hledá cestu ven.“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich es laut aus: „Das ist Stress, der einen Ausweg sucht.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες το δυνατά: «Αυτό είναι άγχος που ψάχνει διέξοδο.»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilo en voz alta: «Esto es estrés buscando una salida»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano se ääneen: ”Tämä on stressiä, joka etsii ulospääsyä.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-le à voix haute : « C'est du stress qui cherche une issue. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़ोर से कहें: “यह तनाव है जो बाहर निकलने का रास्ता ढूँढ रहा है।”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dillo ad alta voce: «È stress che cerca una via d'uscita.»"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხმამაღლა თქვი: „ეს სტრესია, რომელიც გამოსავალს ეძებს.“"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvardyk garsiai: „Tai stresas, ieškantis išeities.“"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det høyt: «Dette er stress som leter etter en vei ut.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg het hardop: ‘Dit is stress die een uitweg zoekt.’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwij to na głos: „To stres, który szuka ujścia”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите вслух: «Это стресс ищет выход»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
