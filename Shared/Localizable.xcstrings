    "Stand near someone who knows you're not drinking." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stůj u někoho, kdo ví, že nepiješ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich zu jemandem, der weiß, dass du nicht trinkst."
