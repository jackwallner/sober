    "Two days in, cells finish rehydrating, headaches subside, and skin tone improves." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dvou dnech jsou buňky znovu hydratované, bolesti hlavy ustupují a pleť vypadá lépe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach zwei Tagen sind die Zellen wieder hydriert, Kopfschmerzen lassen nach und der Teint wird besser."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε δύο μέρες τα κύτταρα ενυδατώνονται ξανά, οι πονοκέφαλοι υποχωρούν και η επιδερμίδα βελτιώνεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A los dos días, las células terminan de rehidratarse, los dolores de cabeza remiten y el tono de la piel mejora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahden päivän jälkeen solut ovat nesteytyneet, päänsäryt hellittävät ja iho näyttää paremmalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au bout de deux jours, les cellules sont réhydratées, les maux de tête s'atténuent et le teint s'améliore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो दिन में कोशिकाओं में पानी लौट आता है, सिरदर्द कम होता है और त्वचा निखरती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo due giorni le cellule si reidratano, il mal di testa si attenua e la pelle migliora."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ორ დღეში უჯრედები დატენიანებას ასრულებს, თავის ტკივილი ცხრება და კანის ფერი უმჯობესდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dviejų dienų ląstelės vėl hidratuotos, galvos skausmai atslūgsta, o oda atrodo geriau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter to dager har cellene fått tilbake væsken, hodepinen gir seg og huden ser bedre ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na twee dagen zijn de cellen weer gehydrateerd, nemen hoofdpijnen af en verbetert je huid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po dwóch dniach komórki są znów nawodnione, bóle głowy słabną, a cera wygląda lepiej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через два дня клетки восстанавливают водный баланс, головные боли стихают, кожа выглядит лучше."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через два дні клітини відновлюють водний баланс, головний біль стихає, шкіра виглядає краще."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau hai ngày, tế bào đủ nước trở lại, cơn đau đầu dịu đi và làn da cải thiện."
          }
        }
      }
    },
    "Two quick questions while it's fresh. Both optional." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě rychlé otázky, dokud je to čerstvé. Obě nepovinné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei kurze Fragen, solange es frisch ist. Beide freiwillig."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δύο γρήγορες ερωτήσεις όσο είναι νωπό. Και οι δύο προαιρετικές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos preguntas rápidas mientras está reciente. Ambas opcionales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksi nopeaa kysymystä, kun se on tuoreessa muistissa. Molemmat vapaaehtoisia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux questions rapides tant que c'est frais. Toutes deux facultatives."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ताज़ा रहते दो छोटे सवाल। दोनों वैकल्पिक।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due domande veloci finché è fresco. Entrambe facoltative."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ორი სწრაფი კითხვა, სანამ ახალია. ორივე არასავალდებულოა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trumpi klausimai, kol prisimeni. Abu neprivalomi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To raske spørsmål mens det er ferskt. Begge valgfrie."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee snelle vragen nu het nog vers is. Allebei optioneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa szybkie pytania, póki pamiętasz. Oba opcjonalne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два коротких вопроса, пока свежо в памяти. Оба необязательны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два коротких питання, поки свіже в пам’яті. Обидва необов’язкові."
