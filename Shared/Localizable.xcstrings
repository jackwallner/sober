    "Free, confidential help is available any time. Reaching out is a strength, not a setback." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatná a důvěrná pomoc je k dispozici kdykoli. Ozvat se je projevem síly, ne krokem zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose, vertrauliche Hilfe gibt es jederzeit. Sich Hilfe zu holen ist ein Zeichen von Stärke, kein Rückschritt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωρεάν, εμπιστευτική βοήθεια είναι διαθέσιμη ανά πάσα στιγμή. Το να ζητήσεις βοήθεια δείχνει δύναμη, δεν είναι πισωγύρισμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay ayuda gratuita y confidencial en cualquier momento. Pedir ayuda demuestra fortaleza, no es un retroceso."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasuta ja konfidentsiaalne abi on alati saadaval. Abi küsimine näitab tugevust, mitte nõrkust."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksutonta ja luottamuksellista apua on saatavilla milloin vain. Avun pyytäminen on vahvuus, ei takaisku."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une aide gratuite et confidentielle est disponible à tout moment. Demander de l'aide est une force, pas un échec."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुफ़्त, गोपनीय मदद कभी भी उपलब्ध है। मदद माँगना पीछे हटना नहीं, बल्कि ताक़त की बात है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingyenes, bizalmas segítség bármikor elérhető. Segítséget kérni erőre vall, és nem visszalépés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un aiuto gratuito e riservato è sempre disponibile. Chiedere aiuto è segno di forza, non un passo indietro."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "უფასო, კონფიდენციალური დახმარება ნებისმიერ დროს ხელმისაწვდომია. დახმარების თხოვნა ძალაა და არა უკან დახევა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemokama, konfidenciali pagalba prieinama bet kada. Kreiptis pagalbos yra stiprybės ženklas, ne nesėkmė."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis og konfidensiell hjelp er tilgjengelig når som helst. Å ta kontakt er en styrke, ikke et tilbakeslag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis, vertrouwelijke hulp is altijd beschikbaar. Hulp zoeken is een teken van kracht, geen stap terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpłatna, poufna pomoc jest dostępna o każdej porze. Proszenie o pomoc to oznaka siły, nie porażki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajutorul gratuit și confidențial este disponibil oricând. Să ceri ajutor este un semn de putere, nu un pas înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатная конфиденциальная помощь доступна в любое время. Обратиться за помощью значит проявить силу, а не потерпеть неудачу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis och konfidentiell hjälp finns när som helst. Att be om hjälp är en styrka, inte ett bakslag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีความช่วยเหลือฟรีและเป็นความลับตลอดเวลา การขอความช่วยเหลือคือความเข้มแข็ง ไม่ใช่ความถดถอย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz ve gizli desteğe her zaman ulaşabilirsin. Yardım istemek bir güç göstergesidir, gerileme değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безкоштовна конфіденційна допомога доступна будь-коли. Просити про допомогу не означає робити крок назад. Це прояв сили."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn có hỗ trợ miễn phí, bảo mật bất cứ lúc nào. Tìm đến sự giúp đỡ là sức mạnh, không phải thất bại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时都可以获得免费、保密的帮助。寻求帮助是勇敢的表现，不是退步。"
          }
        }
      }
    },
    "Friends, a party, a work thing, or someone handing you a drink." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přátelé, večírek, pracovní akce nebo někdo, kdo ti podává skleničku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freunde, eine Party, ein Firmenevent oder jemand, der dir einen Drink reicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φίλοι, ένα πάρτι, κάτι στη δουλειά ή κάποιος που σου προσφέρει ποτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amigos, una fiesta, algo del trabajo o alguien que te da una copa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sõbrad, pidu, tööüritus või keegi, kes sulle jooki pakub."
          }
        },
