        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चूक तभी वापस ली जा सकती है जब वह आपके रिकॉर्ड में सबसे हाल की हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno scivolone si può annullare solo se è il più recente."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წაბორძიკების გაუქმება მხოლოდ მაშინაა შესაძლებელი, თუ ის ყველაზე ბოლოა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
