    "Set a 15-minute timer and keep your hands busy: dishes, a walk, a game." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav si časovač na 15 minut a zabav se třeba mytím nádobí, procházkou nebo hrou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell einen 15-Minuten-Timer und beschäftige deine Hände: Abwasch, Spaziergang, ein Spiel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε χρονόμετρο 15 λεπτών και κράτα τα χέρια σου απασχολημένα: πιάτα, βόλτα, ένα παιχνίδι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un temporizador de 15 minutos y mantén las manos ocupadas: lava los platos, sal a caminar o juega a algo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sea taimer 15 minutiks ja leia tegevust: pese nõusid, jaluta või mängi."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita 15 minuutin ajastin ja pidä kädet kiireisinä: tiskit, kävely, peli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez un minuteur de 15 minutes et occupez-vous les mains : vaisselle, balade ou jeu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 मिनट का टाइमर लगाएँ और हाथ व्यस्त रखें: बर्तन धोना, टहलना या कोई खेल खेलना।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állíts be egy 15 perces időzítőt, és foglald el magad: mosogass el, sétálj vagy játssz valamit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un timer di 15 minuti e tieni le mani occupate: lava i piatti, fai una passeggiata o gioca."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დააყენე 15-წუთიანი ტაიმერი და რამეთი დაკავდი: გარეცხე ჭურჭელი, გაისეირნე ან ითამაშე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusistatyk 15 minučių laikmatį ir užimk rankas: išplauk indus, išeik pasivaikščioti ar pažaisk."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett en tidtaker på 15 minutter og hold hendene opptatt: oppvask, en tur, et spill."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een timer op 15 minuten en houd je handen bezig: doe de afwas, maak een wandeling of speel een spelletje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw minutnik na 15 minut i zajmij się czymś: zmywaniem, spacerem lub grą."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pune un temporizator de 15 minute și ocupă-ți mâinile: spală vasele, plimbă-te sau joacă-te."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте таймер на 15 минут и займите руки: посуда, прогулка, игра."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ en timer på 15 minuter och håll dig sysselsatt: diska, ta en promenad eller spela ett spel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งเวลา 15 นาทีแล้วหาอะไรทำ เช่น ล้างจาน เดินเล่น หรือเล่นเกม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 dakikalık bir sayaç kur ve oyalanacak bir şey bul: bulaşık, yürüyüş veya bir oyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставте таймер на 15 хвилин і займіться чимось: помийте посуд, прогуляйтеся або пограйте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hẹn giờ 15 phút và giữ tay bận rộn: rửa bát, đi dạo, chơi một trò."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 15 分钟计时器，找点事做：洗碗、散步或玩游戏。"
          }
        }
      }
    },
