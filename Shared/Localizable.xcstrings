    "The cascade style mimics a tree growing on a cliff, plunging downward." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskádový styl napodobuje strom rostoucí na útesu, který se sklání dolů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kaskadenstil ahmt einen Baum an einer Klippe nach, der nach unten stürzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το στυλ καταρράκτη μιμείται ένα δέντρο σε γκρεμό που γέρνει προς τα κάτω."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El estilo cascada imita un árbol que crece en un acantilado y cae hacia abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadityyli jäljittelee jyrkänteellä kasvavaa, alas syöksyvää puuta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le style cascade imite un arbre poussant sur une falaise, plongeant vers le bas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झरना शैली चट्टान पर उगते, नीचे झुकते पेड़ जैसी दिखती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo stile a cascata imita un albero che cresce su una scogliera, protendendosi verso il basso."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "კასკადური სტილი კლდეზე ამოსულ, ქვემოთ დაშვებულ ხეს ჰბაძავს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadinis stilius primena ant uolos augantį, žemyn krentantį medį."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaskadestilen etterligner et tre på en klippe som stuper nedover."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cascadestijl bootst een boom na die op een klif groeit en naar beneden duikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl kaskadowy naśladuje drzewo rosnące na klifie i opadające w dół."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каскадный стиль напоминает дерево на скале, ниспадающее вниз."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каскадний стиль нагадує дерево на скелі, що спадає донизу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểu thác đổ mô phỏng cây mọc trên vách đá, rủ xuống dưới."
          }
        }
      }
    },
    "The days leading up to one read lower than your usual. Worth noticing early." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dny před ním vycházejí hůř než obvykle. Stojí za to si toho všimnout včas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tage davor liegen unter deinem Schnitt. Es lohnt sich, das früh zu bemerken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι μέρες πριν από αυτό είναι χαμηλότερες από το συνηθισμένο σου. Αξίζει να το προσέχεις νωρίς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días previos salen más bajos de lo habitual. Vale la pena notarlo pronto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitä edeltävät päivät ovat tavallista alempana. Kannattaa huomata ajoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours qui précèdent sont plus bas que d'habitude. À repérer tôt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उससे पहले के दिन आम से कमज़ोर रहते हैं। इसे जल्दी पहचानना काम का है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni prima risultano più bassi del solito. Vale la pena accorgersene presto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მის წინა დღეები ჩვეულებრივზე დაბალია. ღირს, ადრე შეამჩნიო."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
