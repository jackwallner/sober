          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишаючись тверезим, ви вже заощадили %@. Порадуйте себе інструментами, які допоможуть вам зростати далі."
          }
        },
        "vi" : {
          "stringUnit" : {
