    "Count every day, grow a private bonsai, and see what your body and wallet get back." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítej každý den, pěstuj soukromou bonsaj a sleduj, co se vrací tělu i peněžence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zähl jeden Tag, lass deinen eigenen Bonsai wachsen und sieh, wie dein Körper und dein Geldbeutel davon profitieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μέτρα κάθε μέρα, μεγάλωσε το δικό σου μπονσάι και δες τα οφέλη για το σώμα και το πορτοφόλι σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta cada día, cultiva un bonsái privado y mira lo que recuperan tu cuerpo y tu bolsillo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane iga kaine päev kirja, kasvata oma bonsaid ja vaata, mida su keha ja rahakott tagasi võidavad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laske raittiit päiväsi, kasvata omaa bonsaita ja näe, mitä raittius tuo kehollesi ja säästöillesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez chaque jour, faites pousser votre propre bonsaï et voyez ce que votre corps et votre portefeuille y gagnent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन गिनें, अपना बोनसाई उगाएँ और देखें कि आपके शरीर और जेब को क्या फ़ायदा होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Számolj minden napot, nevelj saját bonszájt, és lásd, mit nyer a tested és a pénztárcád."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta ogni giorno, fai crescere un bonsai tutto tuo e scopri cosa guadagni in benessere e risparmi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დათვალე ყოველი დღე, გაზარდე პირადი ბონსაი და ნახე, რას იბრუნებს სხეული და საფულე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaičiuok kiekvieną dieną, augink savo bonsą ir matyk, ką atgauna kūnas ir piniginė."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell hver dag, dyrk din egen bonsai og se hva kroppen og lommeboka får tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tel je dagen, kweek je eigen bonsai en ontdek wat dat oplevert voor je lichaam en portemonnee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licz każdy dzień, hoduj swoje bonsai i zobacz, co zyskują twoje ciało i portfel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numără fiecare zi, crește un bonsai doar al tău și vezi ce câștigă corpul și portofelul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считайте каждый день, выращивайте личный бонсай и следите за тем, как меняются самочувствие и сбережения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räkna varje dag, odla din egen bonsai och se vad kroppen och plånboken får tillbaka."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นับทุกวัน ปลูกบอนไซส่วนตัว และดูว่าร่างกายกับเงินในกระเป๋าของคุณได้อะไรกลับมา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her günü say, sana özel bir bonsai büyüt ve bedeninle bütçenin neler kazandığını gör."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рахуйте кожен день, вирощуйте власний бонсай і дізнавайтеся, як змінюються ваше тіло та заощадження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm từng ngày, nuôi cây bonsai của riêng bạn và xem cả sức khỏe lẫn túi tiền được lợi ra sao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录每一天，培育属于你的盆景，看看身体和钱包的变化。"
          }
        }
      }
    },
