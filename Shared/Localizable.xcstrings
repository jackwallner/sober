    "Pick what you'll raise in advance: a soda water with lime." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předem si vyber, čím si připiješ: sodovkou s limetkou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheide vorher, womit du anstößt: Sprudelwasser mit Limette."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διάλεξε από πριν με τι θα τσουγκρίσεις: σόδα με λάιμ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige de antemano con qué brindarás: agua con gas y lima."
          }
