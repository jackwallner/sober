          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greinene strekker seg bredere. Formen trer frem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De takken groeien verder uit. De vorm wordt zichtbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
