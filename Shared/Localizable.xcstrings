    "Have a soda water with lime in hand before anyone asks." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měj sodovku s limetkou po ruce dřív, než se někdo zeptá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hab ein Sprudelwasser mit Limette in der Hand, bevor jemand fragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα μια σόδα με λάιμ στο χέρι πριν σε ρωτήσει κανείς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten a mano un vaso de agua con gas y lima antes de que te pregunten."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia laimiga mullivett käes, enne kui keegi küsida jõuab."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä kädessäsi limetillä maustettua kivennäisvettä ennen kuin kukaan ehtii kysyä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayez déjà en main une eau pétillante au citron vert avant qu'on vous propose à boire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई पूछे उससे पहले हाथ में नींबू सोडा रखें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legyen a kezedben egy lime-os szódavíz, mielőtt bárki megkérdezné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni già in mano un'acqua frizzante con lime prima che qualcuno ti offra da bere."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სანამ ვინმე გკითხავს, ხელში გაზიანი წყალი ლაიმით გეჭიროს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dar prieš kam nors paklausiant, laikyk rankoje stiklinę gazuoto vandens su laimu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha farris med lime i hånden før noen spør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg dat je al een glas bruiswater met limoen in je hand hebt voordat iemand iets vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim ktoś zapyta, miej już w ręce wodę gazowaną z limonką."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține în mână o apă minerală cu lime înainte să te întrebe cineva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заранее возьмите газировку с лаймом и держите её в руке."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha ett glas kolsyrat vatten med lime i handen innan någon frågar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถือโซดามะนาวไว้ก่อนที่จะมีใครถาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri sormadan eline limonlu soda al."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Візьміть газовану воду з лаймом, перш ніж хтось запропонує вам випити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cầm sẵn ly soda chanh trước khi ai đó hỏi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在别人问起之前，手里先拿一杯加青柠的苏打水。"
          }
        }
      }
    },
