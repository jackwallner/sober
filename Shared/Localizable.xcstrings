    "Project the year ahead, not just the days behind" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Získej výhled na celý příští rok, nejen na uplynulé dny"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau aufs kommende Jahr, nicht nur auf die vergangenen Tage"
