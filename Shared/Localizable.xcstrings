    "Not today. I want a clear head for this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes ne. Na tohle chci mít čistou hlavu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute nicht. Dafür will ich einen klaren Kopf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όχι σήμερα. Θέλω καθαρό μυαλό γι' αυτό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no. Para esto quiero la cabeza despejada."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täna mitte. Tahan selleks selge peaga olla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
