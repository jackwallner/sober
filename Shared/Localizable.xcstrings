    "Every one of those was a craving that ended without a drink." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá z těch chutí odezněla bez skleničky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Mal ging das Verlangen vorbei, ohne dass du etwas getrunken hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε μία από αυτές ήταν μια λαχτάρα που πέρασε χωρίς να πιεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno fue un antojo que terminó sin una copa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igaüks neist oli tung, mis möödus ilma joomata."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen niistä oli himo, joka päättyi ilman juomaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacune de ces envies est passée sans que vous buviez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से हर एक तलब बिना ड्रिंक के ख़त्म हुई।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindegyik egy olyan sóvárgás volt, amely elmúlt anélkül, hogy ittál volna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuna di quelle voglie è passata senza che tu bevessi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითოეული ლტოლვა სასმელის გარეშე დასრულდა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiekvienas iš jų buvo potraukis, praėjęs neišgėrus."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert av dem var et sug som gikk over uten at du drakk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al die momenten van trek in alcohol gingen voorbij zonder dat je dronk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy z tych napadów głodu minął bez sięgnięcia po alkohol."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare dintre acele pofte a trecut fără să bei alcool."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая из них закончилась без выпивки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje gång var ett sug som gick över utan att du drack."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกครั้งนั้นคือความอยากดื่มที่ผ่านไปโดยที่คุณไม่ได้ดื่ม"
          }
        },
