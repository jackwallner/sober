    "A projection from your current daily figures, not a promise. Change them any time in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jde o odhad podle tvých současných denních hodnot, ne o slib. Kdykoli je můžeš změnit v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Hochrechnung aus deinen aktuellen Tageswerten, kein Versprechen. Passe diese Werte jederzeit in den Einstellungen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρόβλεψη από τα τωρινά ημερήσια στοιχεία σου, όχι υπόσχεση. Άλλαξέ τα όποτε θες στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una proyección con tus cifras diarias actuales, no una promesa. Cámbialas cuando quieras en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinnang põhineb sinu praegustel päevanäitajatel ega ole lubadus. Saad neid igal ajal seadetes muuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arvio perustuu nykyisiin päiväkohtaisiin lukuihisi, eikä se ole lupaus. Voit muuttaa lukuja milloin vain Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une projection à partir de vos chiffres quotidiens actuels, pas une promesse. Modifiez-les à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके मौजूदा रोज़ के आँकड़ों से अनुमान है, वादा नहीं। इन्हें सेटिंग्ज़ में कभी भी बदलें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Becslés a jelenlegi napi adataid alapján, nem ígéret. Bármikor módosíthatod őket a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una proiezione basata sui tuoi valori giornalieri attuali, non una promessa. Puoi modificarli quando vuoi in Impostazioni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "პროგნოზი შენი ამჟამინდელი დღიური მონაცემებით და არა დაპირება. შეცვალე ნებისმიერ დროს პარამეტრებში."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognozė pagal tavo dabartinius dienos duomenis, ne pažadas. Gali juos bet kada pakeisti nustatymuose."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et anslag ut fra dagens tall, ikke et løfte. Endre dem når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een schatting op basis van je huidige dagelijkse cijfers, geen belofte. Je kunt ze op elk moment aanpassen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoza na podstawie twoich obecnych dziennych danych, nie obietnica. Zmień je w dowolnej chwili w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O estimare bazată pe valorile tale zilnice actuale, nu o promisiune. Le poți schimba oricând din Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогноз на основе ваших текущих дневных показателей, а не обещание. Их можно изменить в любой момент в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uppskattning utifrån dina nuvarande dagliga siffror, inte ett löfte. Ändra dem när som helst i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประมาณการจากตัวเลขรายวันปัจจุบัน ไม่ใช่การรับประกัน เปลี่ยนตัวเลขได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut günlük değerlerine dayalı bir tahmindir, vaat değildir. Değerleri Ayarlar’dan istediğin zaman değiştirebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогноз за вашими поточними денними цифрами, а не обіцянка. Змініть їх будь-коли в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dự báo dựa trên số liệu hằng ngày hiện tại, không phải lời hứa. Đổi bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你当前的每日数据估算，并非承诺。你可以随时在设置中修改数据。"
          }
        }
      }
    },
    "A reminder to log the day and water your bonsai, a note when a milestone is a day out, and a heads-up before a free trial converts. Nothing else, and you can turn it all off in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomínka k záznamu dne a zalití bonsaje, oznámení den před milníkem a upozornění, než se bezplatná zkušební doba změní na placenou. Nic víc, vše můžeš vypnout v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Erinnerung, den Tag einzutragen und den Bonsai zu gießen, ein Hinweis am Tag vor einem Meilenstein und ein Hinweis, bevor die kostenlose Testphase in ein kostenpflichtiges Abo übergeht. Sonst nichts. Du kannst alle Mitteilungen in den Einstellungen ausschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπενθύμιση να καταγράψεις τη μέρα και να ποτίσεις το μπονσάι, ένα μήνυμα μία μέρα πριν από ένα ορόσημο και ειδοποίηση πριν μετατραπεί η δωρεάν δοκιμή σε συνδρομή. Τίποτα άλλο. Μπορείς να τα απενεργοποιήσεις όλα από τις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio para registrar el día y regar tu bonsái, un aviso cuando falte un día para un hito y otro antes de que la prueba gratis pase a ser de pago. Nada más, y puedes desactivarlo todo en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meeldetuletus päev kirja panna ja bonsaid kasta, teade päev enne verstaposti ning teavitus enne tasuta prooviperioodi lõppu. Rohkem teateid ei tule ja saad need kõik seadetes välja lülitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutus päivän kirjaamisesta ja bonsain kastelusta, viesti päivää ennen virstanpylvästä ja ilmoitus ennen kuin ilmainen kokeilu muuttuu maksulliseksi. Siinä kaikki. Voit poistaa ilmoitukset käytöstä Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel pour noter la journée et arroser votre bonsaï, un mot la veille d'une étape et une alerte avant la fin d'un essai gratuit. Rien d'autre, et tout se désactive dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन दर्ज करने और बोनसाई को पानी देने की याद, पड़ाव से एक दिन पहले सूचना और मुफ़्त ट्रायल के बाद भुगतान शुरू होने से पहले सूचना। बस इतना, और आप ये सभी सूचनाएँ सेटिंग्ज़ में बंद कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emlékeztetünk, hogy jegyezd fel a napot és öntözd meg a bonszájodat, szólunk egy nappal a mérföldkő előtt és az ingyenes próbaidőszak fizetőssé válása előtt. Másról nem értesítünk, és mindezt kikapcsolhatod a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria per registrare la giornata e annaffiare il bonsai, un avviso il giorno prima di un traguardo e uno prima che finisca la prova gratuita. Nient'altro, e puoi disattivare tutto in Impostazioni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეხსენება დღის ჩასაწერად და ბონსაის მოსარწყავად, შეტყობინება ეტაპამდე ერთი დღით ადრე და გაფრთხილება უფასო საცდელის დასრულებამდე. სულ ესაა. პარამეტრებში ყველაფრის გამორთვა შეგიძლია."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priminimas pažymėti dieną ir palaistyti bonsą, žinutė dieną prieš etapą ir įspėjimas prieš nemokamo bandomojo laikotarpio pabaigą, kai prasidės mokėjimas. Nieko daugiau, viską gali išjungti nustatymuose."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En påminnelse om å registrere dagen og vanne bonsaien, et varsel dagen før en milepæl og en beskjed før prøveperioden går over til et betalt abonnement. Ikke noe mer, og du kan slå av alt i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een herinnering om de dag vast te leggen en je bonsai water te geven, een seintje een dag voor een mijlpaal en een melding voordat je gratis proefperiode overgaat in een betaald abonnement. Verder niets. Je kunt alles uitzetten in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienie o zapisaniu dnia i podlaniu bonsai, powiadomienie dzień przed etapem oraz przed końcem bezpłatnego okresu próbnego. Nic więcej. Wszystko wyłączysz w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un memento ca să înregistrezi ziua și să uzi bonsaiul, o notificare cu o zi înainte să atingi un prag și una înainte ca proba gratuită să devină un abonament cu plată. Nimic altceva. Le poți dezactiva pe toate din Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминание отметить день и полить бонсай, сообщение за день до вехи и предупреждение перед переходом с пробного периода на платную подписку. Больше ничего, и всё это можно выключить в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En påminnelse om att registrera dagen och vattna din bonsai, ett meddelande dagen före en milstolpe och en påminnelse innan en gratis provperiod övergår i en betald prenumeration. Inget annat, och du kan stänga av allt i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เตือนให้บันทึกวันนี้และรดน้ำบอนไซ แจ้งก่อนถึงหมุดหมายหนึ่งวัน และแจ้งก่อนช่วงทดลองฟรีเปลี่ยนเป็นการสมัครรับแบบชำระเงิน ไม่มีการแจ้งเตือนอื่น และคุณปิดทั้งหมดได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günü kaydetmen ve bonsaini sulaman için bir hatırlatma, bir dönüm noktasına bir gün kala bildirim ve ücretsiz deneme ücretli aboneliğe dönüşmeden önce bir uyarı. Hepsi bu. Bunları Ayarlar’dan kapatabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагадування позначити день і полити бонсай, повідомлення за день до віхи й попередження про платне поновлення після безкоштовного пробного періоду. Більше нічого, а все можна вимкнути в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhắc bạn điểm danh và tưới bonsai, báo trước một ngày về cột mốc sắp tới, và báo trước khi gói dùng thử miễn phí chuyển sang gói trả phí. Chỉ có những thông báo này, bạn có thể tắt hết trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会提醒你记录当天情况并给盆景浇水，在里程碑前一天提醒你，也会在免费试用转为付费订阅前提醒你。除此之外没有其他通知，你可以在设置中全部关闭。"
          }
        }
      }
    },
    "A seed is planted. Every great tree starts here." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semínko je zasazené. Každý velký strom začíná tady."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Samen ist gesät. Jeder große Baum beginnt hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας σπόρος φυτεύτηκε. Κάθε μεγάλο δέντρο ξεκινά από εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se planta una semilla. Todo gran árbol empieza aquí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seeme on istutatud. Iga suur puu saab alguse siit."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siemen on istutettu. Jokainen suuri puu alkaa tästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une graine est plantée. Tout grand arbre commence ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीज बोया गया। हर बड़ा पेड़ यहीं से शुरू होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A magot elültetted. Minden nagy fa így kezdi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il seme è stato piantato. Ogni grande albero nasce da qui."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თესლი დაითესა. ყველა დიდი ხე აქედან იწყება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sėkla pasodinta. Kiekvienas didelis medis prasideda čia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
