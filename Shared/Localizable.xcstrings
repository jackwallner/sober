    "Your garden, journal, health timeline, and savings. Everything that keeps you sober." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahrada, deník, časová osa zotavení a úspory. Vše, co ti pomáhá zůstat střízlivý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garten, Tagebuch, Gesundheitsverlauf und Ersparnisse. Alles, was dich nüchtern hält."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κήπος, ημερολόγιο, χρονολόγιο υγείας και οικονομίες. Ό,τι σε κρατά νηφάλιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu jardín, diario, cronología de salud y ahorros. Todo lo que te acompaña en tu camino hacia la sobriedad."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu aed, päevik, tervise ajajoon ja sääst. Kõik, mis toetab sind kainena püsimisel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puutarha, päiväkirja, terveysaikajana ja säästöt. Kaikki, mikä tukee raittiina pysymistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre jardin, votre journal, la chronologie du rétablissement et vos économies. Tout ce qui vous aide à rester sobre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बग़ीचा, डायरी, सेहत की टाइमलाइन और बचत। वह सब जो आपको संयमी रखता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kerted, naplód, egészségügyi idővonalad és megtakarításod. Minden, ami segít józannak maradni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giardino, diario, cronologia della salute e risparmi. Tutto a supporto del tuo percorso di sobrietà."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ბაღი, დღიური, ჯანმრთელობის ქრონიკა და დანაზოგი. ყველაფერი, რაც სიფხიზლის შენარჩუნებაში გეხმარება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodas, dienoraštis, sveikatos laiko juosta ir santaupos. Viskas, kas padeda likti blaiviam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hage, dagbok, helsetidslinje og sparing. Alt som holder deg edru."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tuin, dagboek, gezondheidstijdlijn en besparingen. Alles wat je nuchter houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogród, dziennik, oś czasu zdrowienia i oszczędności. Wszystko, co pomaga zachować trzeźwość."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grădina, jurnalul, cronologia sănătății și economiile. Totul pentru a te susține pe drumul fără alcool."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад, дневник, хроника здоровья и накопления. Всё, что помогает оставаться трезвым."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din trädgård, dagbok, hälsotidslinje och dina besparingar. Allt som hjälper dig att hålla dig nykter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สวน บันทึก ไทม์ไลน์สุขภาพ และเงินที่ประหยัดได้ สิ่งต่างๆ ที่ช่วยให้คุณไม่ดื่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahçen, günlüğün, sağlık zaman çizelgen ve birikimin. Alkolsüz kalmana destek olan her şey."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад, щоденник, хроніка здоров’я та заощадження. Усе, що допомагає залишатися тверезим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khu vườn, nhật ký, dòng thời gian sức khỏe và số tiền tiết kiệm. Mọi thứ giúp bạn duy trì tỉnh táo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的花园、日记、健康时间线和节省记录，陪你坚持戒酒。"
          }
        }
      }
