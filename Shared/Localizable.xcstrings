            "value" : "დღეს არა. ამისთვის ფხიზელი თავი მინდა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne šiandien. Šiam reikalui noriu blaivios galvos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i dag. Jeg vil ha et klart hode for dette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag niet. Hiervoor wil ik een helder hoofd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie dziś. Na to chcę mieć jasną głowę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не сегодня. Для этого мне нужна ясная голова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не сьогодні. Для цього мені потрібна ясна голова."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay thì không. Mình muốn tỉnh táo cho chuyện này."
          }
        }
      }
    },
    "Note" : {
