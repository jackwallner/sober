    "Slept a full eight hours for the first time in years. That alone is worth it." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprvé po letech jsem spal celých osm hodin. Už jen to za to stojí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum ersten Mal seit Jahren volle acht Stunden geschlafen. Allein das lohnt sich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοιμήθηκα ολόκληρες οκτώ ώρες για πρώτη φορά εδώ και χρόνια. Μόνο αυτό αξίζει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormí ocho horas seguidas por primera vez en años. Solo eso ya vale la pena."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nukuin täydet kahdeksan tuntia ensimmäistä kertaa vuosiin. Jo se on sen arvoista."
