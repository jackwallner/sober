          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα διαχρονικό όρθιο μπονσάι. Συμμετρικό, ισορροπημένο, γαλήνιο."
          }
        },
        "es" : {
          "stringUnit" : {
