    "Three months sober, resting heart rate decreases and arterial stiffness improves." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po třech měsících střízlivosti klesá klidová tepová frekvence a tepny jsou pružnější."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach drei nüchternen Monaten sinkt der Ruhepuls und die Arterien werden elastischer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε τρεις μήνες νηφαλιότητας, οι παλμοί σε ηρεμία μειώνονται και οι αρτηρίες γίνονται πιο ελαστικές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras tres meses de sobriedad, baja el pulso en reposo y disminuye la rigidez arterial."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolme kaine kuu järel langeb puhkepulss ja arterite jäikus väheneb."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolmen kuukauden raittiuden jälkeen leposyke laskee ja valtimoiden jäykkyys vähenee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après trois mois de sobriété, la fréquence cardiaque au repos diminue et les artères gagnent en souplesse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संयम के तीन महीने बाद आराम की अवस्था में हृदय गति घटती है और धमनियों की कठोरता कम होती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három hónap józanság után csökken a nyugalmi pulzus és javul az artériák rugalmassága."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo tre mesi di sobrietà, la frequenza cardiaca a riposo diminuisce e la rigidità arteriosa si riduce."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სამი ფხიზელი თვის შემდეგ მოსვენებულ მდგომარეობაში პულსი მცირდება და არტერიები უფრო ელასტიკური ხდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po trijų blaivių mėnesių ramybės pulsas sumažėja, o arterijos tampa elastingesnės."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter tre måneder uten alkohol synker hvilepulsen, og stivheten i arteriene avtar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na drie maanden zonder alcohol daalt de hartslag in rust en neemt de stijfheid van de slagaders af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po trzech miesiącach trzeźwości tętno spoczynkowe spada, a tętnice stają się bardziej elastyczne."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După trei luni fără alcool, ritmul cardiac în repaus scade, iar rigiditatea arterială se reduce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через три трезвых месяца пульс в покое снижается, а артерии становятся эластичнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter tre månader som nykter sjunker vilopulsen och artärernas stelhet minskar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อไม่ดื่มครบสามเดือน อัตราการเต้นหัวใจขณะพักลดลงและหลอดเลือดแดงมีความยืดหยุ่นดีขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç ay alkolsüz yaşadıktan sonra dinlenme nabzı düşer ve atardamar sertliği azalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Через три тверезі місяці пульс у спокої знижується, а артерії стають еластичнішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau ba tháng tỉnh táo, nhịp tim lúc nghỉ giảm và độ cứng động mạch cũng giảm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戒酒三个月后，静息心率降低，动脉僵硬程度改善。"
          }
        }
      }
    },
