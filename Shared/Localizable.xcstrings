          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä menettäisin, jos joisin tänään?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si je buvais aujourd'hui, que perdrais-je ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आज पी लिया, तो क्या-क्या खो जाएगा?"
          }
        },
        "hu" : {
