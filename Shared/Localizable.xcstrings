    "%@. One-time purchase. Lifetime access, no subscription." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jednorázový nákup. Doživotní přístup, bez předplatného."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Einmalkauf. Dauerhafter Zugriff, kein Abo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Εφάπαξ αγορά. Πρόσβαση για πάντα, χωρίς συνδρομή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Compra única. Acceso de por vida, sin suscripción."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Ühekordne ost. Eluaegne ligipääs, tellimuseta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Kertaosto. Elinikäinen käyttöoikeus, ei tilausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Achat unique. Accès à vie, sans abonnement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। एक बार की ख़रीदारी। आजीवन ऐक्सेस, कोई सदस्यता नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Egyszeri vásárlás. Örökös hozzáférés, előfizetés nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Acquisto una tantum. Accesso a vita, nessun abbonamento."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. ერთჯერადი შენაძენი. სამუდამო წვდომა, გამოწერის გარეშე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Vienkartinis pirkinys. Prieiga visam laikui, be prenumeratos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Engangskjøp. Livsvarig tilgang, uten abonnement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Eenmalige aankoop. Levenslange toegang, geen abonnement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Jednorazowy zakup. Dostęp dożywotni, bez subskrypcji."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Plată unică. Acces pe viață, fără abonament."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Разовая покупка. Доступ навсегда, без подписки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Engångsköp. Livstidsåtkomst utan prenumeration."
          }
        },
        "th" : {
