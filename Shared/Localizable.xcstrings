    "Eat something. Hunger and boredom both get mistaken for cravings." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco sněz. Hlad i nuda se často zaměňují za chutě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iss etwas. Hunger und Langeweile werden leicht für Verlangen gehalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φάε κάτι. Η πείνα και η βαρεμάρα συχνά μπερδεύονται με λαχτάρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come algo. El hambre y el aburrimiento se confunden con antojos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söö midagi. Nii nälga kui ka igavust võib tungiga segi ajada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syö jotain. Sekä nälkä että tylsyys sekoitetaan himoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangez quelque chose. On confond souvent la faim et l'ennui avec des envies."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ खा लें। भूख और ऊब दोनों को अक्सर तलब समझ लिया जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyél valamit. Az éhséget és az unalmat is könnyű összetéveszteni a sóvárgással."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia qualcosa. Fame e noia vengono spesso scambiate per voglie."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "რამე ჭამე. შიმშილსა და მოწყენილობას ხშირად ლტოლვაში ურევენ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ką nors suvalgyk. Alkis ir nuobodulys dažnai painiojami su potraukiu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spis noe. Både sult og kjedsomhet forveksles med sug."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eet iets. Honger en verveling worden allebei aangezien voor trek in alcohol."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjedz coś. Głód fizyczny i nuda często udają głód alkoholowy."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mănâncă ceva. Foamea și plictiseala pot fi confundate cu poftele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поешьте. Голод и скуку часто путают с тягой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ät något. Både hunger och uttråkning kan förväxlas med sug."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองกินอะไรสักหน่อย ความหิวและความเบื่ออาจทำให้เข้าใจผิดว่าเป็นความอยากดื่มได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyler ye. Açlık ve can sıkıntısı yoğun istekle karıştırılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поїжте. Голод і нудьгу часто плутають із потягом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ăn chút gì đó. Cơn đói và buồn chán đều dễ bị nhầm là cơn thèm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "吃点东西吧。饥饿和无聊都可能被误认为饮酒冲动。"
          }
        }
      }
    },
