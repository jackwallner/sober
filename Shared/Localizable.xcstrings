    "Make a soda water with lime, or something warm, and keep it in your hand." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udělej si sodovku s limetkou nebo něco teplého a drž to v ruce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach dir ein Sprudelwasser mit Limette oder etwas Warmes und behalt es in der Hand."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε μια σόδα με λάιμ ή κάτι ζεστό και κράτα το στο χέρι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate un agua con gas con lima, o algo caliente, y tenlo en la mano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee itsellesi kivennäisvettä limetillä tai jotain lämmintä ja pidä sitä kädessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez une eau pétillante au citron vert ou une boisson chaude, et gardez-la en main."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नींबू वाला सोडा पानी या कुछ गर्म बनाएँ और हाथ में रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparati un'acqua frizzante con lime o qualcosa di caldo e tienila in mano."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მოიმზადე მინერალური წყალი ლაიმით ან რამე თბილი და ხელში გეჭიროს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasidaryk gazuoto vandens su laimu ar ko nors šilto ir laikyk rankoje."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag deg farris med lime eller noe varmt, og hold det i hånden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een bruiswater met limoen of iets warms en houd het in je hand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób sobie wodę gazowaną z limonką albo coś ciepłego i trzymaj w ręce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте газировку с лаймом или что-то тёплое и держите в руке."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зробіть газовану воду з лаймом або щось тепле й тримайте в руці."
          }
        },
        "vi" : {
