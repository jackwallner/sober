    "Celebrate with something you'll remember: the food, dessert, a photo." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslav to něčím, co si zapamatuješ: jídlem, dezertem, fotkou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feier mit etwas, an das du dich erinnerst: Essen, Dessert, ein Foto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γιόρτασε με κάτι που θα θυμάσαι: το φαγητό, το γλυκό, μια φωτογραφία."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebra con algo que recordarás: la comida, el postre, una foto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juhli jollain, minkä muistat: ruoalla, jälkiruoalla, kuvalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Célébrez avec ce dont vous vous souviendrez : le repas, le dessert, une photo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसी चीज़ से जश्न मनाएँ जो याद रहे: खाना, मिठाई, एक तस्वीर।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festeggia con qualcosa che ricorderai: il cibo, il dolce, una foto."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "იზეიმე იმით, რაც გემახსოვრება: საჭმელით, დესერტით, ფოტოთი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Švęsk tuo, ką prisiminsi: maistu, desertu, nuotrauka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feir med noe du husker: maten, desserten, et bilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier het met iets wat je onthoudt: het eten, het toetje, een foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Świętuj czymś, co zapamiętasz: jedzeniem, deserem, zdjęciem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Празднуйте тем, что запомнится: едой, десертом, фото."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Святкуйте тим, що запам’ятається: їжею, десертом, фото."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ăn mừng bằng điều bạn sẽ nhớ: món ăn, món tráng miệng, một tấm ảnh."
          }
        }
      }
    },
