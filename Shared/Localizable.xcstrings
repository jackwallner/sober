    "Have a soda water with lime in hand before anyone asks." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měj sodovku s limetkou v ruce dřív, než se někdo zeptá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hab ein Sprudelwasser mit Limette in der Hand, bevor jemand fragt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα μια σόδα με λάιμ πριν σε ρωτήσει κανείς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten un agua con gas con lima en la mano antes de que nadie pregunte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä kivennäisvettä limetillä kädessä ennen kuin kukaan kysyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayez une eau pétillante au citron vert en main avant qu'on vous demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई पूछे उससे पहले हाथ में नींबू वाला सोडा पानी रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni in mano un'acqua frizzante con lime prima che qualcuno chieda."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხელში ლაიმიანი მინერალური წყალი გეჭიროს, სანამ ვინმე გკითხავს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turėk rankoje gazuoto vandens su laimu, kol niekas dar neklausė."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha farris med lime i hånden før noen spør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb een bruiswater met limoen in je hand voordat iemand iets vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miej w ręce wodę gazowaną z limonką, zanim ktoś zapyta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держите в руке газировку с лаймом, пока никто не спросил."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте в руці газовану воду з лаймом, поки ніхто не спитав."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cầm sẵn ly soda chanh trước khi ai đó hỏi."
          }
        }
      }
    },
