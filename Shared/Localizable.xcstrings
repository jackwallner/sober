    "Keep your full garden, journal, and savings, or cancel any time before it renews." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponech si celou zahradu, deník i úspory, nebo kdykoli před obnovením zruš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte Garten, Tagebuch und Ersparnisse oder kündige jederzeit vor der Verlängerung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα ολόκληρο τον κήπο, το ημερολόγιο και τις οικονομίες σου ή ακύρωσε πριν την ανανέωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva tu jardín, tu diario y tus ahorros, o cancela antes de la renovación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä koko puutarha, päiväkirja ja säästöt tai peru ennen uusimista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre jardin, votre journal et vos économies, ou annulez avant le renouvellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना पूरा बग़ीचा, डायरी और बचत रखें, या रिन्यू होने से पहले रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni giardino, diario e risparmi, oppure annulla prima del rinnovo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეინარჩუნე ბაღი, დღიური და დანაზოგი ან გააუქმე განახლებამდე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasilik visą sodą, dienoraštį ir santaupas arba atšauk prieš atnaujinimą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold hele hagen, dagboken og sparingen, eller avslutt før fornyelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je tuin, dagboek en besparingen, of zeg op vóór de verlenging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj ogród, dziennik i oszczędności albo anuluj przed odnowieniem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните сад, дневник и накопления или отмените до продления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть сад, щоденник і заощадження або скасуйте до подовження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ toàn bộ khu vườn, nhật ký và tiết kiệm, hoặc hủy trước khi gia hạn."
          }
        }
      }
    },
