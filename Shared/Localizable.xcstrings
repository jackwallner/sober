          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu jardín, diario, cronología de salud y ahorros. Todo lo que te mantiene sobrio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puutarha, päiväkirja, terveysaikajana ja säästöt. Kaikki, mikä pitää sinut raittiina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardin, journal, calendrier santé et économies. Tout ce qui vous aide à rester sobre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बग़ीचा, डायरी, सेहत की टाइमलाइन और बचत। वह सब जो आपको संयमी रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giardino, diario, cronologia della salute e risparmi. Tutto ciò che ti tiene sobrio."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ბაღი, დღიური, ჯანმრთელობის ქრონიკა და დანაზოგი. ყველაფერი, რაც ფხიზლად გტოვებს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sodas, dienoraštis, sveikatos laiko juosta ir santaupos. Viskas, kas padeda likti blaiviam."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hage, dagbok, helsetidslinje og sparing. Alt som holder deg edru."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tuin, dagboek, gezondheidstijdlijn en besparingen. Alles wat je nuchter houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogród, dziennik, oś zdrowia i oszczędności. Wszystko, co pomaga zachować trzeźwość."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад, дневник, хроника здоровья и накопления. Всё, что помогает оставаться трезвым."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сад, щоденник, хроніка здоров’я та заощадження. Усе, що допомагає залишатися тверезим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khu vườn, nhật ký, dòng thời gian sức khỏe và tiết kiệm. Mọi thứ giúp bạn tỉnh táo."
          }
        }
      }
