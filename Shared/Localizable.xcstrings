    "Branches are reaching wider. The shape is emerging." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větve sahají dál. Tvar se začíná rýsovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Äste greifen weiter aus. Die Form zeichnet sich ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλαδιά απλώνονται. Το σχήμα αναδύεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ramas se extienden. La forma empieza a verse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oksat kurottuvat leveämmälle. Muoto alkaa hahmottua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les branches s'élargissent. La forme se dessine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डालियाँ फैल रही हैं। आकार उभर रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rami si allargano. La forma sta emergendo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ტოტები ფართოვდება. ფორმა ჩნდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šakos plečiasi. Ryškėja forma."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Greinene strekker seg bredere. Formen trer frem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De takken reiken breder. De vorm wordt zichtbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gałęzie sięgają szerzej. Kształt się wyłania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ветви раскидываются шире. Форма проявляется."
