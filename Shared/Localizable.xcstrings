    "You've already saved %@ staying sober. Treat yourself to the tools that keep it growing." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Střízlivostí jsi už ušetřil %@. Dopřej si nástroje, díky kterým to poroste dál."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast nüchtern schon %@ gespart. Gönn dir die Werkzeuge, die es weiter wachsen lassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχεις ήδη γλιτώσει %@ μένοντας νηφάλιος. Χάρισε στον εαυτό σου τα εργαλεία που το κάνουν να μεγαλώνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya ahorraste %@ manteniéndote sobrio. Date el gusto de tener las herramientas que lo hacen crecer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet jo säästänyt %@ raittiina. Hanki itsellesi työkalut, joilla se kasvaa."
          }
