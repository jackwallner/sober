          }
        }
      }
    },
    "A timeless upright bonsai. Symmetrical, balanced, serene." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadčasová vzpřímená bonsaj. Souměrná, vyvážená, klidná."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
