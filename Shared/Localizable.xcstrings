    "A lacy maple in warm autumn red and gold. Star-shaped leaves drift down as the days add up." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javor s jemně vykrajovanými listy v teplých podzimních odstínech červené a zlaté. Hvězdicovité listy opadávají, jak přibývají dny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein filigraner Ahorn in warmem Herbstrot und Gold. Sternförmige Blätter fallen, während sich die Tage summieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα σφενδάμι με δαντελωτά φύλλα σε ζεστές φθινοπωρινές αποχρώσεις του κόκκινου και του χρυσού. Τα αστερόσχημα φύλλα πέφτουν καθώς περνούν οι μέρες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arce japonés de hojas finamente recortadas, en cálidos tonos otoñales de rojo y dorado. Sus hojas en forma de estrella caen con el paso de los días."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Õrnalehine vaher sügisestes punastes ja kuldsetes toonides. Tähekujulised lehed langevad päevade lisandudes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitsimäinen vaahtera syksyn lämpimissä punaisen ja kullan sävyissä. Tähdenmuotoiset lehdet leijailevat päivien kertyessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un érable au feuillage finement découpé, aux teintes rouges et dorées de l'automne. Ses feuilles en étoile tombent au fil des jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शरद के गर्म लाल और सुनहरे रंगों वाला नाज़ुक मेपल। दिन बढ़ने पर तारे जैसी पत्तियाँ झरती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finom lombú juhar meleg őszi vörösben és aranyban. A napok múlásával csillag alakú levelek hullanak róla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un acero dalle foglie finemente frastagliate, nei caldi toni rossi e dorati dell'autunno. Le foglie a stella cadono man mano che i giorni si accumulano."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მაქმანასავით ფოთლებიანი ნეკერჩხალი შემოდგომის თბილ წითელ და ოქროსფერ ტონებში. ვარსკვლავისებრი ფოთლები დღეების მატებასთან ერთად ცვივა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klevas su nėriniuotais lapais, nusidažiusiais šiltais raudonais ir auksiniais rudens atspalviais. Žvaigždės formos lapai krinta, kai daugėja dienų."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En luftig lønn i varme høstfarger, rødt og gull. Stjerneformede blader daler ned mens dagene går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een sierlijke esdoorn in warm herfstrood en goud. Stervormige bladeren dwarrelen neer terwijl de dagen verstrijken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klon o koronkowych liściach w ciepłych jesiennych odcieniach czerwieni i złota. Gwiaździste liście opadają, gdy przybywa dni."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un arțar cu frunze delicate, în nuanțe calde de roșu și auriu. Frunzele în formă de stea cad pe măsură ce trec zilele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ажурный клён в тёплых красно-золотых осенних тонах. Листья в форме звёзд опадают с каждым новым днём."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sirlig lönn i varma höstfärger, rött och guld. Stjärnformade löv faller medan dagarna går."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมเปิลใบละเอียดสีแดงและทองอบอุ่นดุจฤดูใบไม้ร่วง ใบรูปดาวโปรยปรายเมื่อวันเวลาผ่านไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonbaharın sıcak kızıl ve altın tonlarında zarif bir akçaağaç. Günler geçtikçe yıldız biçimli yapraklar süzülür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клен із мереживним листям у теплих осінніх червоних і золотих барвах. Листочки у формі зірочок опадають, поки зростає серія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cây phong lá ren sắc đỏ vàng mùa thu. Lá hình sao rơi xuống khi ngày tháng tăng dần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "枝叶纤细的枫树，披着温暖的秋红与金黄。日子一天天过去，星形的叶片轻轻飘落。"
          }
        }
      }
    },
    "A legendary bonsai. A full year of growth made visible." : {
