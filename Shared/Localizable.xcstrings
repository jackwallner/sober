    "Your tree kept its growth. Day one starts now." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strom si svůj růst ponechal. První den začíná teď."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Baum hat sein Wachstum behalten. Tag eins beginnt jetzt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το δέντρο σου κράτησε την ανάπτυξή του. Η πρώτη μέρα ξεκινά τώρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu árbol conservó su crecimiento. El día uno empieza ahora."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu puu kasv jäi alles. Nüüd algab esimene päev."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puusi säilytti kasvunsa. Ensimmäinen päivä alkaa nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre arbre a conservé sa croissance. Le jour 1 commence maintenant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पेड़ ने अपनी बढ़त बनाए रखी। पहला दिन अब शुरू होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fád megőrizte a növekedését. Most kezdődik az első nap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo albero ha mantenuto la sua crescita. Il primo giorno inizia ora."
