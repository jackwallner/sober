    "Shaped by a lifetime of wind. Every branch tells a story of endurance." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvářená celoživotním větrem. Každá větev vypráví příběh vytrvalosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geformt von einem Leben voller Wind. Jeder Ast erzählt von Ausdauer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σμιλεμένο από μια ζωή ανέμου. Κάθε κλαδί λέει μια ιστορία αντοχής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moldeado por toda una vida de viento. Cada rama cuenta una historia de resistencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elinikäisen tuulen muovaama. Jokainen oksa kertoo sitkeydestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Façonné par une vie de vent. Chaque branche raconte l'endurance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़िंदगी भर की हवा ने इसे गढ़ा है। हर डाली धैर्य की कहानी कहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plasmato da una vita di vento. Ogni ramo racconta una storia di resistenza."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მთელი ცხოვრების ქარმა გამოძერწა. ყოველი ტოტი გამძლეობის ამბავს ყვება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išformuotas viso gyvenimo vėjų. Kiekviena šaka pasakoja apie ištvermę."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formet av et liv i vind. Hver grein forteller om utholdenhet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevormd door een leven lang wind. Elke tak vertelt een verhaal van volharding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukształtowane przez całe życie na wietrze. Każda gałąź opowiada o wytrwałości."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сформирован ветрами за всю жизнь. Каждая ветвь рассказывает о стойкости."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сформований вітрами за все життя. Кожна гілка розповідає про витривалість."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được gió tạc nên suốt một đời. Mỗi cành kể câu chuyện về sự bền bỉ."
          }
        }
      }
    },
