    "It's already smaller than it was a minute ago, even if it doesn't feel finished." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už je menší než před minutou, i když to ještě nepůsobí jako konec."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist schon kleiner als vor einer Minute, auch wenn es sich nicht vorbei anfühlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι ήδη μικρότερη από πριν από ένα λεπτό, ακόμα κι αν δεν νιώθεις ότι τελείωσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
