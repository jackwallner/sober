    "Set a 15-minute timer and keep your hands busy: dishes, a walk, a game." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastav si minutku na 15 minut a zaměstnej ruce: nádobí, procházka, hra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell einen 15-Minuten-Timer und beschäftige deine Hände: Abwasch, Spaziergang, ein Spiel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε χρονόμετρο 15 λεπτών και κράτα τα χέρια σου απασχολημένα: πιάτα, βόλτα, ένα παιχνίδι."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un temporizador de 15 minutos y mantén las manos ocupadas: platos, un paseo, un juego."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita 15 minuutin ajastin ja pidä kädet kiireisinä: tiskit, kävely, peli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez un minuteur de 15 minutes et occupez vos mains : vaisselle, balade, jeu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 मिनट का टाइमर लगाएँ और हाथ व्यस्त रखें: बर्तन, टहलना, कोई खेल।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un timer di 15 minuti e tieni le mani occupate: piatti, una passeggiata, un gioco."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დააყენე 15-წუთიანი ტაიმერი და ხელები დაიკავე: ჭურჭელი, გასეირნება, თამაში."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nusistatyk 15 minučių laikmatį ir užimk rankas: indai, pasivaikščiojimas, žaidimas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett en tidtaker på 15 minutter og hold hendene i arbeid: oppvask, en tur, et spill."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een timer op 15 minuten en houd je handen bezig: afwas, een wandeling, een spel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw minutnik na 15 minut i zajmij ręce: naczynia, spacer, gra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставьте таймер на 15 минут и займите руки: посуда, прогулка, игра."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставте таймер на 15 хвилин і займіть руки: посуд, прогулянка, гра."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hẹn giờ 15 phút và giữ tay bận rộn: rửa bát, đi dạo, chơi một trò."
          }
        }
      }
    },
