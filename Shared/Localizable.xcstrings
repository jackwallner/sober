    "Almost through. Whatever's left of it is on its way out." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Už to skoro přešlo. I to, co zbylo, brzy odezní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast geschafft. Der Rest wird bald abgebaut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδόν τελείωσε. Ό,τι έχει μείνει φεύγει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya casi termina. Lo que queda ya está desapareciendo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peaaegu möödas. Ka see, mis veel alles, hakkab vaibuma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melkein ohi. Se, mitä on jäljellä, on jo lähdössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presque fini. Ce qu'il en reste est en train de partir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह लगभग ख़त्म हो चुका है। जो थोड़ा बचा है, वह भी निकल रहा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Már majdnem túl vagy rajta. Ami még maradt, az is múlóban van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi finito. Quel che resta se ne sta andando."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითქმის გადალახე. რაც დარჩა, უკვე მიდის."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beveik praėjo. Kas liko, jau traukiasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snart over. Det som er igjen, er på vei ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijna voorbij. Wat er nog over is, ebt al weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawie po wszystkim. To, co zostało, już mija."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproape a trecut. Ce a mai rămas se risipește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почти всё. То, что осталось, уже уходит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snart över. Det som finns kvar håller på att klinga av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใกล้ผ่านไปแล้ว ความอยากดื่มที่เหลือกำลังค่อยๆ จางลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neredeyse geçti. Geriye kalanı da geçmek üzere."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Майже позаду. Те, що залишилося, вже минає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp qua rồi. Phần còn lại đang dần biến mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快过去了。剩下的感觉也会慢慢消退。"
          }
        }
      }
    },
    "An evergreen pine with cloud-like needle tiers and a gnarled, weathered trunk." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stálezelená borovice s patry jehlic jako mraky a sukovitým, ošlehaným kmenem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine immergrüne Kiefer mit wolkenförmigen Nadelpolstern und knorrigem, verwittertem Stamm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα αειθαλές πεύκο με πυκνές συστάδες βελονών σαν σύννεφα και ροζιασμένο κορμό σμιλεμένο από τον καιρό."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pino perenne con capas de agujas como nubes y un tronco nudoso y curtido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igihaljas mänd pilvetaoliste okkakihtide ja ilmast kulunud pahkliku tüvega."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikivihreä mänty, jonka neulasoksat muodostavat pilvimäisiä kerroksia. Runko on muhkurainen ja sään kuluttama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pin toujours vert, avec des étages d'aiguilles évoquant des nuages et un tronc noueux et patiné."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बादल जैसी सुइयों की परतों और गाँठदार, पुराने तने वाला सदाबहार चीड़।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örökzöld fenyő felhőszerű tűlevélpárnákkal és göcsörtös, időjárta törzzsel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pino sempreverde con palchi di aghi come nuvole e un tronco nodoso e segnato dal tempo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მარადმწვანე ფიჭვი ღრუბლისებრი წიწვების იარუსებითა და კვანძიანი, ქარ-წვიმით დაღარული ტანით."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visžalė pušis su debesų pavidalo spyglių pakopomis ir gumbuotu, vėjų nugairintu kamienu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eviggrønn furu med skylignende lag av nåler og en knudrete, værbitt stamme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een groenblijvende den met wolkachtige naaldlagen en een knoestige, verweerde stam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zimozielona sosna z warstwami igieł przypominającymi obłoki i sękatym pniem naznaczonym upływem czasu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pin veșnic verde, cu ace dispuse în straturi ca niște nori și un trunchi noduros, modelat de vreme."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вечнозелёная сосна с ярусами хвои, похожими на облака, и узловатым обветренным стволом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vintergrön tall med molnlika lager av barr och en knotig, väderbiten stam."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สนเขียวชอุ่มตลอดปี มีพุ่มใบเป็นชั้นคล้ายเมฆและลำต้นคดปุ่มป่ำผ่านกาลเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulutları andıran kat kat iğne yaprakları ve boğumlu, yıllanmış gövdesiyle her dem yeşil bir çam."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вічнозелена сосна з ярусами хвої, схожими на хмари, і вузлуватим обвітреним стовбуром."
