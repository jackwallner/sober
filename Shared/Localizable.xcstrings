    "Switch anytime. Your day count and growth carry over to whichever tree you choose." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měň kdykoli. Počet dní i růst přejdou na jakýkoli strom, který si vybereš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jederzeit wechselbar. Tage und Wachstum gehen auf jeden Baum über, den du wählst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε όποτε θες. Οι μέρες και η ανάπτυξη περνούν σε όποιο δέντρο διαλέξεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia cuando quieras. Tus días y tu crecimiento pasan al árbol que elijas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda milloin vain. Päivät ja kasvu siirtyvät mihin tahansa valitsemaasi puuhun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez quand vous voulez. Vos jours et votre croissance passent à l'arbre choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी भी बदलें। आपके दिन और बढ़त चुने गए किसी भी पेड़ में साथ जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia quando vuoi. Giorni e crescita passano all'albero che scegli."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეცვალე ნებისმიერ დროს. დღეები და ზრდა ნებისმიერ არჩეულ ხეზე გადადის."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keisk bet kada. Dienos ir augimas pereina į bet kurį pasirinktą medį."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt når du vil. Dagene og veksten følger med til treet du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel wanneer je wilt. Je dagen en groei gaan mee naar elke boom die je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieniaj w dowolnej chwili. Dni i wzrost przechodzą na wybrane drzewo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняйте в любой момент. Дни и рост переходят на любое выбранное дерево."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінюйте будь-коли. Дні й ріст переходять на будь-яке вибране дерево."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi bất cứ lúc nào. Số ngày và sự phát triển chuyển sang cây bạn chọn."
          }
        }
      }
    },
