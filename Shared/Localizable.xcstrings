    "Write down the one thing weighing on you and the next small step on it." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapiš si tu jednu věc, která tě tíží, a další malý krok, jak ji řešit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
