    "Name it out loud: \"This is stress looking for a way out.\"" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojmenuj to nahlas: „Tohle je stres, který hledá cestu ven.“"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich es laut aus: „Das ist Stress, der einen Ausweg sucht.“"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες το δυνατά: «Αυτό είναι άγχος που ψάχνει διέξοδο.»"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilo en voz alta: «Esto es estrés buscando una salida»."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ütle valjusti: „See on stress, mis otsib väljapääsu.”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano se ääneen: ”Tämä on stressiä, joka etsii ulospääsyä.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-le à voix haute : « C'est du stress qui cherche une issue. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़ोर से कहें: “यह तनाव है जो बाहर निकलने का रास्ता ढूँढ रहा है।”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondd ki hangosan: „A stressz keres így kiutat.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dillo ad alta voce: «È stress che cerca una via d'uscita.»"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ხმამაღლა თქვი: „ეს სტრესია, რომელიც გამოსავალს ეძებს.“"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvardyk garsiai: „Tai stresas, ieškantis išeities.“"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si det høyt: «Dette er stress som leter etter en vei ut.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg het hardop: ‘Dit is stress die een uitweg zoekt.’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwij to na głos: „To stres, który szuka ujścia”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune cu voce tare: „E stresul care caută o cale de ieșire.”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите вслух: «Это стресс ищет выход»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg det högt: ”Det här är stress som söker en utväg.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดออกมาดังๆ ว่า \"นี่คือความเครียดที่กำลังหาทางออก\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek sesle söyle: \"Bu, çıkış yolu arayan stres.\""
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажіть уголос: «Це стрес шукає вихід»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói to lên: “Đây là căng thẳng đang tìm lối thoát.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大声说出来：“这是压力在寻找出口。”"
          }
        }
      }
    },
