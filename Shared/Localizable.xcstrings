          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सालों में पहली बार पूरे आठ घंटे सोया। बस यही इसके लायक है।"
          }
        },
        "it" : {
          "stringUnit" : {
