    { "index": 2, "id": "seedling",   "title": "Seedling",     "dayThreshold":   7 },
    { "index": 3, "id": "young",      "title": "Young Bonsai", "dayThreshold":  14 },
    { "index": 4, "id": "adolescent", "title": "Adolescent",   "dayThreshold":  30 },
    { "index": 5, "id": "mature",     "title": "Mature",       "dayThreshold":  60 },
    { "index": 6, "id": "refined",    "title": "Refined",      "dayThreshold":  90 },
    { "index": 7, "id": "ancient",    "title": "Ancient",      "dayThreshold": 180 },
    { "index": 8, "id": "legendary",  "title": "Legendary",    "dayThreshold": 365 }
