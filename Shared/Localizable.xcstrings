    "%@ Cancel any time in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zrušit můžeš kdykoli v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Jederzeit in den Einstellungen kündbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ακύρωσε όποτε θες στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cancela cuando quieras en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tühista igal ajal seadetes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Voit perua milloin vain Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Annulez à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ सेटिंग्ज़ में कभी भी रद्द करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Bármikor lemondhatod a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Puoi annullare quando vuoi in Impostazioni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ გააუქმე ნებისმიერ დროს პარამეტრებში."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Atšaukti gali bet kada nustatymuose."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Avslutt når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Altijd op te zeggen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Anuluj w dowolnej chwili w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Poți anula oricând din Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Отменить можно в любой момент в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Avsluta när som helst i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ayarlar’dan istediğin zaman iptal edebilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Скасувати можна будь-коли в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hủy bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 可随时在设置中取消。"
          }
