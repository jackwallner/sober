    "Tell the host or one friend ahead of time, so nobody pushes." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekni to předem hostiteli nebo jednomu příteli, ať nikdo nenaléhá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag dem Gastgeber oder einem Freund vorher Bescheid, damit dich niemand zum Trinken drängt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες το από πριν στον οικοδεσπότη ή σε έναν φίλο, για να μη σε πιέσει κανείς."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Díselo antes al anfitrión o a un amigo para que nadie insista."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ütle võõrustajale või ühele sõbrale ette, et keegi ei avaldaks sulle survet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro etukäteen juhlien järjestäjälle tai yhdelle ystävälle, ettei kukaan painosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévenez l'hôte ou un ami à l'avance, pour que personne n'insiste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले से मेज़बान या किसी दोस्त को बता दें ताकि कोई दबाव न डाले।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szólj előre a házigazdának vagy egy barátodnak, hogy senki ne kínálgasson."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa prima chi ospita o un amico, così nessuno insiste."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წინასწარ უთხარი მასპინძელს ან ერთ მეგობარს, რომ არავინ ჩაგაცივდეს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iš anksto pasakyk šeimininkui ar vienam draugui, kad niekas nespaustų."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fra til verten eller én venn på forhånd, så ingen maser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel het vooraf aan de gastheer of een vriend, zodat niemand aandringt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uprzedź gospodarza albo jednego przyjaciela, żeby nikt nie naciskał."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune-i dinainte gazdei sau unui prieten, ca nimeni să nu insiste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заранее скажите хозяину или другу, чтобы никто не настаивал."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta för värden eller en vän i förväg, så slipper du påtryckningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกเจ้าของงานหรือเพื่อนสักคนล่วงหน้า จะได้ไม่มีใครคะยั้นคะยอให้ดื่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimsenin ısrar etmemesi için ev sahibine veya bir arkadaşına önceden haber ver."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заздалегідь скажіть господарю чи другові, щоб ніхто не наполягав."
