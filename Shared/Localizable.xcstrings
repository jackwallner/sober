        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ნაქარგივით ნეკერჩხალი შემოდგომის თბილ წითელსა და ოქროსფერში. ვარსკვლავისებრი ფოთლები დღეებთან ერთად ცვივა."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėriniuotas klevas šiltomis rudens raudonomis ir auksinėmis spalvomis. Žvaigždės formos lapai krenta, kai daugėja dienų."
          }
