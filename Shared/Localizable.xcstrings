        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आज आपने संयम रखा है, तो उसे दर्ज करें और बग़ीचे को पानी दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
