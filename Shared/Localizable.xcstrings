    "Nothing to do, and the old habit offers to fill the time." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když nemáš co dělat, starý zvyk se nabízí jako způsob, jak vyplnit čas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn nichts los ist, meldet sich die alte Gewohnheit und will die Zeit füllen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα να κάνεις, και η παλιά συνήθεια προσφέρεται να γεμίσει τον χρόνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando no hay nada que hacer, el viejo hábito aparece para llenar el tiempo."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midagi pole teha ja vana harjumus kipub tühja aega täitma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei mitään tekemistä, ja vanha tapa tarjoutuu täyttämään ajan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à faire, et l'ancienne habitude vient combler le vide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "करने को कुछ न हो, तो पुरानी आदत खाली समय भरने का रास्ता सुझाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs mit csinálnod, és a régi szokáshoz nyúlnál, hogy teljen az idő."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai niente da fare e la vecchia abitudine si offre di riempire il tempo."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "გასაკეთებელი არაფერია და ძველი ჩვევა დროის შევსებას გთავაზობს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėra ką veikti, o senas įprotis siūlosi užpildyti laiką."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting å gjøre, og den gamle vanen lokker med å fylle tomrommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is niets te doen en de oude gewoonte wil de tijd wel vullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma nic do roboty, a stary nawyk kusi, by jakoś zapełnić ten czas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ai nimic de făcut, iar vechiul obicei pare o cale de a umple timpul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заняться нечем, и старая привычка предлагает заполнить время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har inget att göra och den gamla vanan lockar med att fylla tiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อไม่มีอะไรทำ ความเคยชินเก่าๆ ก็ชวนให้ดื่มเพื่อฆ่าเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapacak bir şey yokken eski alışkanlık zamanı doldurmak için ortaya çıkıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нема чим зайнятися, і стара звичка пропонує заповнити час."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có việc gì làm, thói quen cũ lại muốn lấp đầy khoảng thời gian trống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无事可做时，老习惯就会冒出来，想填满这段时间。"
          }
        }
      }
    },
    "Nothing to read yet" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatím není co vyhodnotit"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts auszuwerten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχεις κάτι να διαβάσεις ακόμα"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada que leer"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veel pole midagi lugeda"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei vielä luettavaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à lire pour l'instant"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी पढ़ने को कुछ नहीं"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs mit elemezni"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun dato"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "წასაკითხი ჯერ არაფერია"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kol kas nėra ko parodyti"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting å lese ennå"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets te lezen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie nic do przeczytania"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu sunt încă date"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока нет данных"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget att läsa än"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่มีข้อมูลให้อ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz incelenecek bir şey yok"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки нічого читати"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có gì để đọc"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时没有足够的记录"
          }
        }
      }
    },
    "Notice it without arguing with it. You're not trying to win, you're waiting it out." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všímej si jí, ale nehádej se s ní. Nesnažíš se vyhrát, jen to přečkáváš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachte es, ohne dagegen anzukämpfen. Du musst es nicht bezwingen, sondern nur abwarten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρατήρησέ τη χωρίς να της αντιστέκεσαι. Δεν προσπαθείς να νικήσεις, απλώς περιμένεις να περάσει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsérvalo sin discutir con él. No intentas ganar, solo esperas a que pase."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pane seda tähele, ilma et hakkaksid vastu vaidlema. Sa ei pea seda võitma, vaid ootad, kuni see möödub."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa se väittämättä vastaan. Et yritä voittaa sitä, vaan odotat, että se menee ohi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observez-la sans lutter. Vous n'essayez pas de gagner, vous attendez qu'elle passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तलब को बिना बहस किए पहचानें। आप जीतने की कोशिश नहीं कर रहे, बस इसके गुज़रने का इंतज़ार कर रहे हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyeld meg anélkül, hogy küzdenél ellene. Nem kell legyőznöd, csak kivárnod, amíg elmúlik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osservala senza cercare di combatterla. Non devi vincere, devi solo aspettare che passi."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეამჩნიე, ოღონდ არ ეკამათო. მოგებას არ ცდილობ, უბრალოდ ელოდები, რომ გადაიაროს."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastebėk jį nesiginčydamas. Nebandai laimėti, tiesiog lauki, kol praeis."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg merke til suget uten å krangle med det. Du prøver ikke å vinne, bare å vente til det går over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk het op zonder ermee in discussie te gaan. Je wilt niet winnen, je wacht het af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zauważ go, nie kłócąc się z nim. Nie próbujesz wygrać, tylko go przeczekujesz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observă pofta fără să te lupți cu ea. Nu trebuie să câștigi, doar să aștepți să treacă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замечайте её, не споря с ней. Вы не пытаетесь победить, вы её пережидаете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg märke till suget utan att kämpa emot det. Du behöver inte vinna, bara vänta tills det går över."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับรู้ความอยากโดยไม่ต้องต่อสู้กับมัน คุณไม่ต้องเอาชนะ แค่รอให้มันผ่านไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onunla mücadele etmeden farkına var. Kazanmaya çalışmıyorsun, geçmesini bekliyorsun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помічайте його, не сперечаючись. Ви не намагаєтеся перемогти, ви його перечікуєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy để ý mà không tranh cãi với nó. Bạn không cần thắng, chỉ cần chờ nó qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留意这种感觉，不必和它较劲。你不需要战胜它，只要等它过去。"
          }
        }
      }
    },
    "Notifications are turned off for Sober, so the reminder can't be delivered. Tap above to enable them in the Settings app." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení jsou pro Sober vypnutá, takže připomínka nemůže přijít. Klepnutím výše je zapneš v Nastavení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen für Sober sind aus, daher kann die Erinnerung nicht ankommen. Tippe oben, um sie in den Einstellungen zu aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις του Sober είναι απενεργοποιημένες, οπότε δεν μπορεί να σταλεί η υπενθύμιση. Πάτα παραπάνω για να τις ενεργοποιήσεις στις Ρυθμίσεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Sober están desactivadas, así que el recordatorio no puede llegar. Toca arriba para activarlas en Ajustes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soberi teavitused on välja lülitatud, seega ei saa meeldetuletust saata. Puuduta ülal, et need rakenduses Seaded sisse lülitada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soberin ilmoitukset ovat pois päältä, joten muistutus ei voi tulla perille. Ota ne käyttöön Asetuksissa napauttamalla yllä olevaa kohtaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de Sober sont désactivées, le rappel ne peut donc pas vous parvenir. Touchez ci-dessus pour les activer dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sober के लिए सूचनाएँ बंद हैं, इसलिए रिमाइंडर नहीं पहुँच सकता। सेटिंग्ज़ ऐप में चालू करने के लिए ऊपर टैप करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sober értesítései ki vannak kapcsolva, ezért az emlékeztető nem érkezhet meg. Koppints fent, és kapcsold be őket a Beállításokban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche di Sober sono disattivate, quindi il promemoria non può arrivare. Tocca sopra per attivarle in Impostazioni."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sober-ის შეტყობინებები გამორთულია, ამიტომ შეხსენება ვერ მოვა. ზემოთ შეეხე, რომ პარამეტრებში ჩართო."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sober pranešimai išjungti, todėl priminimas negali ateiti. Paspausk aukščiau ir įjunk juos nustatymuose."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varslinger er slått av for Sober, så påminnelsen kan ikke leveres. Trykk ovenfor for å slå dem på i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen staan uit voor Sober, dus de herinnering kan niet aankomen. Tik hierboven om ze aan te zetten in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia dla Sober są wyłączone, więc przypomnienie nie dotrze. Stuknij powyżej, aby je włączyć w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificările pentru Sober sunt dezactivate, așa că mementoul nu poate fi trimis. Atinge mai sus pentru a le activa în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления для Sober выключены, поэтому напоминание не придёт. Нажмите выше, чтобы включить их в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiser är avstängda för Sober, så påminnelsen kan inte skickas. Tryck ovan för att slå på dem i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนของ Sober ปิดอยู่ จึงส่งการเตือนไม่ได้ แตะด้านบนเพื่อเปิดการแจ้งเตือนในแอปการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sober için bildirimler kapalı, bu yüzden hatırlatıcı gönderilemiyor. Ayarlar uygulamasında açmak için yukarıya dokun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення для Sober вимкнено, тож нагадування не надійде. Торкніться вище, щоб увімкнути їх у Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo của Sober đang tắt nên lời nhắc không thể gửi đến. Chạm vào phía trên để bật trong ứng dụng Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sober 的通知已关闭，因此无法发送提醒。轻点上方前往设置 App 开启通知。"
          }
        }
      }
    },
