    "Decide when you're leaving before you arrive, and tell one person." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmysli si, kdy odejdeš, ještě než dorazíš, a řekni to někomu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg fest, wann du gehst, bevor du ankommst, und sag es einer Person."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποφάσισε πότε θα φύγεις πριν φτάσεις και πες το σε κάποιον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decide cuándo te irás antes de llegar y díselo a una persona."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otsusta enne kohalejõudmist, millal lahkud, ja ütle seda ühele inimesele."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päätä lähtöaikasi ennen kuin saavut, ja kerro siitä yhdelle ihmiselle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décidez avant d'arriver à quelle heure vous repartirez, et prévenez quelqu'un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहुँचने से पहले तय करें कि कब निकलेंगे और किसी एक को बता दें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még érkezés előtt döntsd el, mikor indulsz el, és mondd el valakinek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidi quando andartene prima di arrivare e dillo a una persona."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "მისვლამდე გადაწყვიტე, როდის წახვალ, და ერთ ადამიანს უთხარი."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš atvykdamas nuspręsk, kada išeisi, ir pasakyk vienam žmogui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestem når du skal gå før du kommer, og si det til én person."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bepaal voordat je aankomt wanneer je weggaat, en vertel het aan één persoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim przyjdziesz, zdecyduj, kiedy wyjdziesz, i powiedz to jednej osobie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotărăște când vei pleca înainte să ajungi și spune-i cuiva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заранее решите, когда уйдёте, и скажите об этом одному человеку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestäm när du ska gå redan innan du kommer dit och berätta det för någon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนจะไป ลองกำหนดเวลาที่จะกลับและบอกใครสักคนไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gitmeden önce ne zaman ayrılacağına karar ver ve bunu bir kişiye söyle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вирішіть, коли підете, ще до приходу, і скажіть про це одній людині."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
