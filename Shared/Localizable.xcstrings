    "Almost through. Whatever's left of it is on its way out." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skoro hotovo. Co z ní zbylo, už odchází."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast geschafft. Was noch übrig ist, ist auf dem Weg nach draußen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδόν τελείωσε. Ό,τι έχει μείνει φεύγει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casi lo logras. Lo que queda ya se está yendo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melkein ohi. Se mitä on jäljellä, on jo lähdössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presque fini. Ce qu'il en reste est en train de partir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगभग पार। जो बचा है वह जा रहा है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quasi finito. Quel che resta se ne sta andando."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თითქმის გადალახე. რაც დარჩა, უკვე მიდის."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beveik praėjo. Kas liko, jau traukiasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesten gjennom. Det som er igjen, er på vei ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bijna erdoorheen. Wat er nog over is, is op weg naar buiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawie po wszystkim. To, co zostało, już odchodzi."
