    "Switch anytime. Your day count and growth carry over to whichever tree you choose." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strom můžeš kdykoli změnit. Počet dní i růst se přenesou na strom, který si vybereš."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit wechseln. Dein Tageszähler und das Wachstum werden auf den Baum deiner Wahl übertragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Άλλαξε όποτε θες. Ο μετρητής ημερών και η ανάπτυξη μεταφέρονται σε όποιο δέντρο διαλέξεις."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia cuando quieras. El contador de días y el crecimiento se transfieren al árbol que elijas."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaheta millal tahes. Päevade arv ja kasv kanduvad üle sinu valitud puule."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihda milloin vain. Päivien määrä ja kasvu siirtyvät valitsemaasi puuhun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez quand vous voulez. Votre compteur de jours et la croissance de votre arbre sont conservés, quel que soit l'arbre choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेड़ कभी भी बदलें। दिनों की गिनती और बढ़त आपके चुने हुए पेड़ पर बनी रहेगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármikor válthatsz. A napok száma és a növekedés átkerül a választott fára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia quando vuoi. Giorni e crescita passano all'albero che scegli."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეცვალე ნებისმიერ დროს. დღეები და ზრდა ნებისმიერ არჩეულ ხეზე გადადის."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keisk bet kada. Kad ir kurį medį pasirinktum, dienų skaičius ir augimas išliks."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt når du vil. Dagene og veksten følger med til treet du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel wanneer je wilt. Je dagenteller en de groei gaan mee naar de boom die je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zmienić drzewo w dowolnej chwili. Licznik dni i postęp wzrostu przeniosą się na wybrane drzewo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbă oricând. Numărul de zile și creșterea se păstrează pentru orice copac alegi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняйте дерево в любой момент. Счётчик дней и рост сохранятся, какое бы дерево вы ни выбрали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt när du vill. Dagarna och tillväxten följer med till trädet du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนได้ทุกเมื่อ จำนวนวันและการเติบโตจะย้ายไปยังต้นไม้ที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğin zaman değiştir. Gün sayın ve büyümen seçtiğin ağaca aktarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дерево можна змінити будь-коли. Лічильник днів і прогрес росту збережуться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đổi bất cứ lúc nào. Số ngày và phần tăng trưởng được chuyển sang cây bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时切换。无论选择哪棵树，天数和生长进度都会保留。"
          }
        }
      }
    },
