          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi no. Per questo voglio la testa lucida."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "დღეს არა. ამჯერად ფხიზელი გონებით მინდა ვიყო."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne šiandien. Šiam reikalui noriu blaivios galvos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke i dag. Jeg vil ha et klart hode for dette."
          }
        },
        "nl" : {
          "stringUnit" : {
