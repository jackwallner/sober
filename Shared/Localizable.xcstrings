            "state" : "translated",
            "value" : "Τα κλαδιά απλώνονται. Το σχήμα αρχίζει να διαμορφώνεται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ramas se extienden. La forma empieza a verse."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oksad sirutuvad laiemale. Kuju hakkab välja joonistuma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oksat kurottuvat leveämmälle. Muoto alkaa hahmottua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les branches s'élargissent. La forme se dessine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डालियाँ फैल रही हैं। आकार उभर रहा है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ágak egyre szélesebbre nyúlnak. Kirajzolódik a forma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rami si allargano. La sagoma si sta delineando."
          }
        },
