        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показники за дні перед ним були нижчими за ваш звичний рівень. Варто помічати це заздалегідь."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước một lần lỡ uống, tâm trạng của bạn thường xuống thấp hơn mức bình thường. Nên để ý sớm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在饮酒前的几天，你记录的心情往往比平时低落。早点留意会有帮助。"
          }
        }
      }
    },
    "The house is quiet and the old routine starts knocking." : {
