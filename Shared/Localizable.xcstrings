    "You don't have to do anything else right now. Just stay here and breathe." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teď nemusíš dělat nic jiného. Jen tu zůstaň a dýchej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst gerade nichts anderes tun. Bleib einfach hier und atme."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν χρειάζεται να κάνεις τίποτα άλλο τώρα. Απλώς μείνε εδώ και ανάπνεε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no tienes que hacer nada más. Solo quédate aquí y respira."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinun ei tarvitse tehdä nyt mitään muuta. Pysy vain tässä ja hengitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez rien d'autre à faire pour l'instant. Restez là et respirez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी आपको और कुछ करने की ज़रूरत नहीं। बस यहीं रहें और साँस लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adesso non devi fare nient'altro. Resta qui e respira."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ახლა სხვა არაფრის გაკეთება არ გჭირდება. უბრალოდ აქ დარჩი და ისუნთქე."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dabar nieko kito daryti nereikia. Tiesiog būk čia ir kvėpuok."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke gjøre noe annet nå. Bare bli her og pust."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft nu niets anders te doen. Blijf gewoon hier en adem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz nie musisz robić nic więcej. Po prostu zostań tu i oddychaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас больше ничего делать не нужно. Просто побудьте здесь и дышите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз більше нічого робити не треба. Просто побудьте тут і дихайте."
          }
        },
