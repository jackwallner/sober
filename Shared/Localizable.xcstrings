        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είσαι κοντά στην κορυφή. Η λαχτάρα ανεβαίνει γρήγορα και μετά σταματά να ανεβαίνει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es casi el punto más alto. Los antojos suben rápido y luego dejan de subir."
