    "When they hit, what sets them off, how long yours last." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdy přicházejí, co je spouští, jak dlouho trvají."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann es kommt, was es auslöst, wie lange es dauert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πότε έρχονται, τι τις πυροδοτεί, πόσο κρατούν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo llegan, qué los provoca, cuánto duran."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Milloin ne iskevät, mikä ne laukaisee, kauanko ne kestävät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand elles arrivent, ce qui les déclenche, combien de temps elles durent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कब आती है, क्या भड़काता है, कितनी देर टिकती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando arrivano, cosa le scatena, quanto durano."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "როდის მოდის, რა იწვევს, რამდენ ხანს გრძელდება."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada užeina, kas sukelia, kiek trunka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det kommer, hva som utløser det, hvor lenge det varer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer het komt, wat het opwekt, hoe lang het duurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiedy przychodzi, co go wywołuje, ile trwa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда приходит, что вызывает, сколько длится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли приходить, що викликає, скільки триває."
